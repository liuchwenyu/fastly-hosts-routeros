# Fastly Hosts RouterOS 1.0.0 single-file installer.
# Import installs native scripts and runs local selftests. It does NOT apply DNS.
# Based on AFAlimru/fastly-hosts-adjust v0.8.3 (MIT). See the accompanying LICENSE.
:global FHRInstallSources [:toarray ""]

{
    :global FHRInstallSources
    :local source "# Fastly Hosts RouterOS - configuration and service profiles\n# MIT; derived from AFAlimru/fastly-hosts-adjust v0.8.3 (see LICENSE).\n# This file supplies defaults; saved settings take precedence on later loads.\n:global FHRConfig\n:global FHRProfiles\n:set FHRConfig {\n    \"version\"=\"1.0.0\";\n    \"excluded\"=\"|SIN|QPG|\";\n    \"region\"=\"\";\n    \"parallel\"=8;\n    \"rounds\"=3;\n    \"shortlist\"=10;\n    \"sampleBytes\"=8388608;\n    \"sampleSeconds\"=20;\n    \"probeSeconds\"=6;\n    \"smoothFloorBps\"=3000000;\n    \"smoothPercent\"=30;\n    \"stickyPercent\"=20;\n    \"cacheSeconds\"=86400;\n    \"cacheStaleSeconds\"=604800;\n    \"dnsTTL\"=\"5m\";\n    \"sourceAddress\"=\"0.0.0.0\";\n    \"vrf\"=\"\";\n    \"resolver\"=\"\";\n    \"maxTextBytes\"=1048576;\n    \"maxBlocks\"=16384;\n    \"healthFailures\"=3;\n    \"healthFailOpen\"=true;\n    \"adoptLegacy\"=true;\n    \"allowLatencyFallback\"=true;\n    \"nearMarginMs\"=60;\n    \"latencyProbe\"=\"tcp\";\n    \"verbose\"=false;\n    \"releaseRepos\"={\"ollama/ollama\";\"cli/cli\";\"AFAlimru/fastly-hosts-adjust\"};\n    \"priorityBlocks\"={\"151.101.192.0\";\"151.101.0.0\";\"151.101.64.0\";\"151.101.128.0\";\"167.82.0.0\";\"167.82.32.0\";\"199.232.160.0\"};\n    \"fallbackCIDRs\"={\"23.235.32.0/20\";\"43.249.72.0/22\";\"90.98.0.0/17\";\"90.98.128.0/18\";\"103.244.50.0/24\";\"103.245.222.0/23\";\"103.245.224.0/24\";\"104.156.80.0/20\";\"140.248.64.0/18\";\"140.248.128.0/17\";\"146.75.0.0/17\";\"151.101.0.0/16\";\"157.52.64.0/18\";\"167.82.0.0/17\";\"167.82.128.0/20\";\"167.82.160.0/20\";\"167.82.224.0/20\";\"172.111.64.0/18\";\"185.31.16.0/22\";\"199.27.72.0/21\";\"199.232.0.0/16\"}\n}\n:set FHRProfiles [:toarray \"\"]\n:set (\$FHRProfiles->\"github\") {\n    \"key\"=\"github\";\"enabled\"=true;\"mode\"=\"github\";\n    \"probeHost\"=\"raw.githubusercontent.com\";\n    \"probePath\"=\"/github/gitignore/main/README.md\";\"suffix\"=133;\n    \"anyStatus\"=false;\"popHost\"=\"\";\"testURL\"=\"\";\n    \"hosts\"={\"raw.githubusercontent.com\"=133;\"release-assets.githubusercontent.com\"=133};\n    \"paths\"={\"raw.githubusercontent.com\"=\"/github/gitignore/main/README.md\";\"release-assets.githubusercontent.com\"=\"/\"}\n}\n:set (\$FHRProfiles->\"x\") {\n    \"key\"=\"x\";\"enabled\"=true;\"mode\"=\"via\";\"via\"=\"github\";\n    \"probeHost\"=\"pbs.twimg.com\";\n    \"probePath\"=\"/profile_images/1683325380441128960/yRsRRjGO_400x400.jpg\";\n    \"suffix\"=159;\"anyStatus\"=false;\"popHost\"=\"\";\"testURL\"=\"\";\n    \"hosts\"={\"pbs.twimg.com\"=159};\n    \"paths\"={\"pbs.twimg.com\"=\"/profile_images/1683325380441128960/yRsRRjGO_400x400.jpg\"}\n}\n:set (\$FHRProfiles->\"twitch\") {\n    \"key\"=\"twitch\";\"enabled\"=true;\"mode\"=\"twitch\";\n    \"probeHost\"=\"static-cdn.jtvnw.net\";\n    \"probePath\"=\"/jtv_user_pictures/xarth/404_user_70x70.png\";\n    \"suffix\"=214;\"anyStatus\"=false;\n    \"popHost\"=\"k.twitchcdn.net\";\"popPath\"=\"/\";\"popSuffix\"=167;\n    \"testURL\"=\"\";\n    \"hosts\"={\"www.twitch.tv\"=214;\"gql.twitch.tv\"=214;\"static-cdn.jtvnw.net\"=214;\"assets.twitch.tv\"=214;\"k.twitchcdn.net\"=167};\n    \"paths\"={\"www.twitch.tv\"=\"/\";\"gql.twitch.tv\"=\"/\";\"static-cdn.jtvnw.net\"=\"/jtv_user_pictures/xarth/404_user_70x70.png\";\"assets.twitch.tv\"=\"/\";\"k.twitchcdn.net\"=\"/\"}\n}\n"
    :onerror err in={:local compiled [:parse $source]} do={:error ("Compile check failed: FHR.config: " . $err)}
    :set ($FHRInstallSources->"config") $source
}

{
    :global FHRInstallSources
    :local source "# Pure helpers. All network and configuration writes live in other modules.\n:global FHRTrim do={\n    :local s [:tostr \$1]\n    :while ([:len \$s] > 0) do={\n        :local c [:pick \$s 0 1]\n        :if ((\$c = \" \") || (\$c = \"\\r\") || (\$c = \"\\n\") || (\$c = \"\\t\")) do={:set s [:pick \$s 1 [:len \$s]]} else={:break}\n    }\n    :while ([:len \$s] > 0) do={\n        :local c [:pick \$s ([:len \$s] - 1) [:len \$s]]\n        :if ((\$c = \" \") || (\$c = \"\\r\") || (\$c = \"\\n\") || (\$c = \"\\t\")) do={:set s [:pick \$s 0 ([:len \$s] - 1)]} else={:break}\n    }\n    :return \$s\n}\n:global FHRSplit do={\n    :local s [:tostr \$1]; :local sep [:tostr \$2]; :local out [:toarray \"\"]; :local pos 0\n    :if ([:len \$sep] = 0) do={:error \"split: empty separator\"}\n    :while (\$pos <= [:len \$s]) do={\n        :local end [:find \$s \$sep \$pos]\n        :if ([:typeof \$end] = \"nil\") do={:set out (\$out, [:pick \$s \$pos [:len \$s]]); :break}\n        :set out (\$out, [:pick \$s \$pos \$end]); :set pos (\$end + [:len \$sep])\n    }\n    :return \$out\n}\n:global FHRHeader do={\n    :global FHRTrim; :global FHRSplit\n    :local headers \$1; :local wanted [:convert transform=lc [:tostr \$2]]\n    :if ([:typeof \$headers] = \"array\") do={\n        :foreach k,v in=\$headers do={\n            :if ([:convert transform=lc [:tostr \$k]] = \$wanted) do={:return [\$FHRTrim \$v]}\n            :local line [:tostr \$v]; :local p [:find \$line \":\"]\n            :if ([:typeof \$p] != \"nil\") do={\n                :if ([:convert transform=lc [\$FHRTrim [:pick \$line 0 \$p]]] = \$wanted) do={:return [\$FHRTrim [:pick \$line (\$p + 1) [:len \$line]]]}\n            }\n        }\n    } else={\n        # Legacy text fallback. The observed 7.24.5 representation is an array.\n        :foreach line in=[\$FHRSplit [:tostr \$headers] (\"\\n\")] do={\n            :foreach piece in=[\$FHRSplit \$line \";\"] do={\n                :local p [:find \$piece \":\"]\n                :if ([:typeof \$p] != \"nil\") do={\n                    :if ([:convert transform=lc [\$FHRTrim [:pick \$piece 0 \$p]]] = \$wanted) do={:return [\$FHRTrim [:pick \$piece (\$p + 1) [:len \$piece]]]}\n                }\n            }\n        }\n    }\n    :return \"\"\n}\n:global FHRPop do={\n    :global FHRSplit; :global FHRTrim\n    :local answer \"?\"\n    :foreach item in=[\$FHRSplit [:tostr \$1] \",\"] do={\n        :local parts [\$FHRSplit [\$FHRTrim \$item] \"-\"]\n        :if ([:len \$parts] >= 3) do={\n            :local last [:tostr (\$parts->([:len \$parts] - 1))]\n            :if (((\$parts->0) = \"cache\") && (\$last ~ \"^[A-Za-z]{3}\\\$\")) do={:set answer [:convert transform=uc \$last]}\n        }\n    }\n    :return \$answer\n}\n:global FHRIPNum do={\n    :global FHRSplit\n    :local parts [\$FHRSplit [:tostr \$1] \".\"]; :local out 0\n    :if ([:len \$parts] != 4) do={:error \"invalid IPv4\"}\n    :foreach s in=\$parts do={\n        :if (!([:tostr \$s] ~ \"^[0-9]{1,3}\\\$\")) do={:error \"invalid IPv4 octet\"}\n        :local n [:tonum \$s]\n        :if ((\$n < 0) || (\$n > 255)) do={:error \"invalid IPv4 octet\"}\n        :set out (\$out * 256 + \$n)\n    }\n    :return \$out\n}\n:global FHRNumIP do={\n    :local n [:tonum \$1]\n    :if ((\$n < 0) || (\$n > 4294967295)) do={:error \"IPv4 number out of range\"}\n    :return ((\$n / 16777216) . \".\" . ((\$n / 65536) % 256) . \".\" . ((\$n / 256) % 256) . \".\" . (\$n % 256))\n}\n:global FHRSame24 do={\n    :global FHRIPNum; :global FHRNumIP\n    :local s [:tonum \$2]\n    :if (([:typeof \$s] = \"nil\") || (\$s < 0) || (\$s > 255)) do={:error \"invalid suffix\"}\n    :local n [\$FHRIPNum \$1]\n    :return [\$FHRNumIP ((\$n / 256) * 256 + \$s)]\n}\n:global FHRCIDR do={\n    :global FHRIPNum\n    :local s [:tostr \$1]; :local slash [:find \$s \"/\"]\n    :if ([:typeof \$slash] = \"nil\") do={:error \"CIDR has no prefix length\"}\n    :local bits [:tonum [:pick \$s (\$slash + 1) [:len \$s]]]\n    :if (([:typeof \$bits] = \"nil\") || (\$bits < 0) || (\$bits > 32)) do={:error \"invalid CIDR prefix\"}\n    :local n [\$FHRIPNum [:pick \$s 0 \$slash]]; :local size 1\n    :if (\$bits < 32) do={:for i from=1 to=(32 - \$bits) do={:set size (\$size * 2)}}\n    :local base ((\$n / \$size) * \$size)\n    :return {\"base\"=\$base;\"last\"=(\$base + \$size - 1);\"prefix\"=\$bits}\n}\n:global FHRInRanges do={\n    :global FHRIPNum; :global FHRCIDR\n    :local n [\$FHRIPNum \$1]\n    :foreach cidr in=\$2 do={\n        :local r [\$FHRCIDR \$cidr]\n        :if ((\$n >= (\$r->\"base\")) && (\$n <= (\$r->\"last\"))) do={:return true}\n    }\n    :return false\n}\n:global FHRBlocks do={\n    :global FHRCIDR; :global FHRNumIP\n    :local blocks [:toarray \"\"]; :local seen [:toarray \"\"]; :local maximum [:tonum \$2]\n    :foreach cidr in=\$1 do={\n        :local r [\$FHRCIDR \$cidr]; :local first (((\$r->\"base\") / 256) * 256); :local last (((\$r->\"last\") / 256) * 256)\n        :for n from=\$first to=\$last step=256 do={\n            :local ip [\$FHRNumIP \$n]\n            :if ([:typeof (\$seen->\$ip)] ~ \"^(nil|nothing)\\\$\") do={\n                :set (\$seen->\$ip) true; :set (\$blocks->[:len \$blocks]) \$ip\n                :if ([:len \$blocks] > \$maximum) do={:error \"CIDR expansion exceeds maxBlocks; nothing was silently truncated\"}\n            }\n        }\n    }\n    :return \$blocks\n}\n:global FHRAllowed do={\n    :global FHRConfig\n    :local pop [:convert transform=uc [:tostr \$1]]; :local region [:convert transform=uc [:tostr \$2]]\n    :if (!(\$pop ~ \"^[A-Z]{3}\\\$\")) do={:return false}\n    :if ([:typeof [:find (\$FHRConfig->\"excluded\") (\"|\" . \$pop . \"|\")]] != \"nil\") do={:return false}\n    :if ((\$region != \"\") && (\$pop != \$region)) do={:return false}\n    :return true\n}\n:global FHRHostValid do={\n    :global FHRSplit\n    :local h [:tostr \$1]\n    :if (([:len \$h] < 3) || ([:len \$h] > 253)) do={:return false}\n    :local labels [\$FHRSplit \$h \".\"]\n    :if ([:len \$labels] < 2) do={:return false}\n    :foreach label in=\$labels do={\n        :if (([:len \$label] < 1) || ([:len \$label] > 63)) do={:return false}\n        :if (!(\$label ~ \"^[a-z0-9]([a-z0-9-]*[a-z0-9])?\\\$\")) do={:return false}\n    }\n    :local tld [:tostr (\$labels->([:len \$labels] - 1))]\n    :if (!(\$tld ~ \"^[a-z]{2,63}\\\$\")) do={:return false}\n    :return true\n}\n:global FHRURL do={\n    :global FHRHostValid\n    :local u [:tostr \$1]\n    :if ([:pick \$u 0 8] != \"https://\") do={:error \"only HTTPS URLs are accepted\"}\n    :local slash [:find \$u \"/\" 8]\n    :if ([:typeof \$slash] = \"nil\") do={:set u (\$u . \"/\"); :set slash ([:len \$u] - 1)}\n    :local h [:convert transform=lc [:pick \$u 8 \$slash]]\n    :if (![\$FHRHostValid \$h]) do={:error \"URL must use a DNS hostname without credentials or a nonstandard port\"}\n    :if ((\$u ~ \"[\\r\\n]\") || ([:typeof [:find \$u \"#\"]] != \"nil\")) do={:error \"invalid URL control character or fragment\"}\n    :return {\"url\"=\$u;\"host\"=\$h;\"path\"=[:pick \$u \$slash [:len \$u]]}\n}\n:global FHRMedian do={\n    :local values \$1; :local sorted [:toarray \"\"]\n    :foreach n in=\$values do={\n        :local added false; :local next [:toarray \"\"]\n        :foreach q in=\$sorted do={\n            :if ((!\$added) && (\$n < \$q)) do={:set (\$next->[:len \$next]) \$n; :set added true}\n            :set (\$next->[:len \$next]) \$q\n        }\n        :if (!\$added) do={:set (\$next->[:len \$next]) \$n}\n        :set sorted \$next\n    }\n    :local count [:len \$sorted]\n    :if (\$count = 0) do={:return 0}\n    :if ((\$count % 2) = 1) do={:return (\$sorted->(\$count / 2))}\n    :return (((\$sorted->(\$count / 2 - 1)) + (\$sorted->(\$count / 2))) / 2)\n}\n:global FHRBetter do={\n    # Upstream ordering: smooth count, median throughput, connection latency.\n    # Stable deterministic IP order is the final tie-break, not a POP preference.\n    :local a \$1; :local b \$2\n    :if ([:len \$b] = 0) do={:return true}\n    :if ((\$a->\"smooth\") != (\$b->\"smooth\")) do={:return ((\$a->\"smooth\") > (\$b->\"smooth\"))}\n    :if ((\$a->\"medianBps\") != (\$b->\"medianBps\")) do={:return ((\$a->\"medianBps\") > (\$b->\"medianBps\"))}\n    :if ((\$a->\"latencyUs\") != (\$b->\"latencyUs\")) do={:return ((\$a->\"latencyUs\") < (\$b->\"latencyUs\"))}\n    :global FHRIPNum\n    :return ([\$FHRIPNum (\$a->\"ip\")] < [\$FHRIPNum (\$b->\"ip\")])\n}\n:global FHRRank do={\n    :global FHRConfig; :global FHRMedian; :global FHRBetter\n    :local rows \$1; :local samples \$2; :local peak 0; :local out [:toarray \"\"]\n    :foreach key,s in=\$samples do={:foreach value in=(\$s->\"rates\") do={:if (\$value > \$peak) do={:set peak \$value}}}\n    :local threshold (\$peak * (\$FHRConfig->\"smoothPercent\") / 100)\n    :if (\$threshold < (\$FHRConfig->\"smoothFloorBps\")) do={:set threshold (\$FHRConfig->\"smoothFloorBps\")}\n    :foreach row in=\$rows do={\n        :local s (\$samples->(\$row->\"ip\")); :local rates [:toarray \"\"]\n        :local smooth 0; :local valid 0\n        :if ([:typeof \$s] = \"array\") do={:set rates (\$s->\"rates\"); :set valid (\$s->\"valid\")}\n        :foreach rate in=\$rates do={:if (\$rate >= \$threshold) do={:set smooth (\$smooth + 1)}}\n        :set (\$row->\"smooth\") \$smooth; :set (\$row->\"valid\") \$valid\n        :set (\$row->\"medianBps\") [\$FHRMedian \$rates]\n        :set (\$row->\"thresholdBps\") \$threshold; :set (\$row->\"samples\") \$rates\n        :local next [:toarray \"\"]; :local added false\n        :foreach old in=\$out do={\n            :if ((!\$added) && [\$FHRBetter \$row \$old]) do={:set (\$next->[:len \$next]) \$row; :set added true}\n            :set (\$next->[:len \$next]) \$old\n        }\n        :if (!\$added) do={:set (\$next->[:len \$next]) \$row}\n        :set out \$next\n    }\n    :return \$out\n}\n:global FHRRange do={\n    :global FHRSplit\n    :local text [:tostr \$1]\n    :if ([:pick \$text 0 6] != \"bytes \") do={:return [:toarray \"\"]}\n    :local range [\$FHRSplit [:pick \$text 6 [:len \$text]] \"/\"]\n    :if ([:len \$range] != 2) do={:return [:toarray \"\"]}\n    :local span [\$FHRSplit (\$range->0) \"-\"]\n    :if ([:len \$span] != 2) do={:return [:toarray \"\"]}\n    :local first [:tonum (\$span->0)]; :local last [:tonum (\$span->1)]; :local total [:tonum (\$range->1)]\n    :if (([:typeof \$first] = \"nil\") || ([:typeof \$last] = \"nil\") || ([:typeof \$total] = \"nil\")) do={:return [:toarray \"\"]}\n    :if ((\$first < 0) || (\$last < \$first) || (\$total <= \$last)) do={:return [:toarray \"\"]}\n    :return {\"first\"=\$first;\"last\"=\$last;\"total\"=\$total}\n}\n"
    :onerror err in={:local compiled [:parse $source]} do={:error ("Compile check failed: FHR.core: " . $err)}
    :set ($FHRInstallSources->"core") $source
}

{
    :global FHRInstallSources
    :local source "# Small recoverable JSON files. Probe payloads are never written to storage.\n:global FHRDir\n:if ([:len [/file find where name=\"flash\"]] > 0) do={:set FHRDir \"flash/fhr-state\"} else={:set FHRDir \"fhr-state\"}\n:if ([:len [/file find where name=\$FHRDir]] = 0) do={/file add name=\$FHRDir type=directory}\n:global FHRStateStem do={\n    :local fhrStateName [:tostr \$1]\n    :if (!(\$fhrStateName ~ \"^[a-z0-9._-]+\\\$\")) do={:error \"unsafe state key\"}\n    :if ([:len \$fhrStateName] > 160) do={:return (\"long-\" . [:convert transform=md5 to=hex \$fhrStateName])}\n    :return \$fhrStateName\n}\n:global FHRReadJSON do={\n    :global FHRDir; :global FHRStateStem\n    :local stem [\$FHRStateStem \$1]\n    :local result [:toarray \"\"]; :local good false; :local sawFile false\n    :foreach suffix in={\"\";\".prev\"} do={\n        :local path (\$FHRDir . \"/\" . \$stem . \".json\" . \$suffix)\n        :if ((!\$good) && ([:len [/file find where name=\$path]] > 0)) do={\n            :set sawFile true\n            :local fhrStateText \"\"\n            :onerror fhrAccessError in={\n                :set fhrStateText [/file get [/file find where name=\$path] contents]\n            } do={:error (\"state access failed: \" . \$stem . \": \" . \$fhrAccessError)}\n            :if (([:len \$fhrStateText] = 0) && ([/file get [/file find where name=\$path] size] > 0)) do={\n                :error (\"state contents unavailable: \" . \$stem . \"; check sensitive permission; existing files retained\")\n            }\n            :onerror e in={\n                :set result [:deserialize from=json options=json.no-string-conversion value=\$fhrStateText]\n                :if ([:typeof \$result] != \"array\") do={:error \"JSON root must be an object or array\"}\n                :set good true\n            } do={:set result [:toarray \"\"]; :log warning (\"FHR: invalid JSON state \" . \$stem . \$suffix . \"; checking previous copy\")}\n        }\n    }\n    :if (\$sawFile && (!\$good)) do={:error (\"state has no valid JSON copy: \" . \$stem . \"; existing files retained\")}\n    :return \$result\n}\n:global FHRWriteJSON do={\n    :global FHRDir; :global FHRStateStem\n    :local fhrStateName [\$FHRStateStem \$1]; :local value \$2\n    :if (!(\$fhrStateName ~ \"^[a-z0-9._-]+\\\$\")) do={:error \"unsafe state filename\"}\n    :local text [:serialize to=json options=json.no-string-conversion value=\$value]\n    :if ([:len \$text] > 57000) do={:error \"state file exceeds safe 57KB limit\"}\n    :local path (\$FHRDir . \"/\" . \$fhrStateName . \".json\"); :local temp (\$path . \".new\"); :local previous (\$path . \".prev\")\n    :if ([:len [/file find where name=\$temp]] > 0) do={/file remove [/file find where name=\$temp]}\n    /file add name=\$temp type=file contents=\$text\n    :local check [/file get [/file find where name=\$temp] contents]\n    :if (\$check != \$text) do={:error \"state write did not verify; existing file retained\"}\n    :local parsed [:deserialize from=json options=json.no-string-conversion value=\$check]\n    :if ([:typeof \$parsed] != \"array\") do={:error \"state write is not valid JSON\"}\n    :if ([:len [/file find where name=\$path]] > 0) do={\n        :if ([:len [/file find where name=\$previous]] > 0) do={/file remove [/file find where name=\$previous]}\n        /file set [/file find where name=\$path] name=\$previous\n    }\n    /file set [/file find where name=\$temp] name=\$path\n}\n:global FHRDeleteState do={\n    :global FHRDir; :global FHRStateStem\n    :local stem [\$FHRStateStem \$1]\n    :foreach suffix in={\"\";\".prev\";\".new\"} do={\n        :local path (\$FHRDir . \"/\" . \$stem . \".json\" . \$suffix)\n        :if ([:len [/file find where name=\$path]] > 0) do={/file remove [/file find where name=\$path]}\n    }\n}\n:global FHRSaveSettings do={\n    :global FHRConfig; :global FHRProfiles; :global FHRWriteJSON\n    \$FHRWriteJSON \"settings\" ({\"config\"=\$FHRConfig;\"profiles\"=\$FHRProfiles})\n}\n:global FHRLoadSettings do={\n    :global FHRConfig; :global FHRProfiles; :global FHRReadJSON\n    :local saved [\$FHRReadJSON \"settings\"]\n    :if ([:typeof (\$saved->\"config\")] = \"array\") do={:foreach k,v in=(\$saved->\"config\") do={:if (\$k != \"version\") do={:set (\$FHRConfig->\$k) \$v}}}\n    :if ([:typeof (\$saved->\"profiles\")] = \"array\") do={:foreach k,v in=(\$saved->\"profiles\") do={:set (\$FHRProfiles->\$k) \$v}}\n}\n:global FHRCacheWrite do={\n    # Page caches to keep every state file below RouterOS's file/get limit.\n    :global FHRWriteJSON; :global FHRReadJSON; :global FHRDeleteState\n    :local key [:tostr \$1]; :local rows \$2; :local pages 0; :local chunk [:toarray \"\"]\n    :local old [\$FHRReadJSON (\"cache-\" . \$key)]\n    :local generation [:tostr ([:tonsec [:timestamp]] / 1000000000)]\n    :foreach row in=\$rows do={\n        :local compact {\"ip\"=(\$row->\"ip\");\"pop\"=(\$row->\"pop\");\"latencyUs\"=(\$row->\"latencyUs\");\"latencyKind\"=(\$row->\"latencyKind\");\"headMs\"=(\$row->\"headMs\")}\n        :set (\$chunk->[:len \$chunk]) \$compact\n        :if ([:len \$chunk] >= 150) do={\n            \$FHRWriteJSON (\"cache-\" . \$key . \"-\" . \$generation . \"-\" . \$pages) \$chunk\n            :set pages (\$pages + 1); :set chunk [:toarray \"\"]\n        }\n    }\n    :if ([:len \$chunk] > 0) do={\n        \$FHRWriteJSON (\"cache-\" . \$key . \"-\" . \$generation . \"-\" . \$pages) \$chunk\n        :set pages (\$pages + 1)\n    }\n    \$FHRWriteJSON (\"cache-\" . \$key) ({\"generation\"=\$generation;\"pages\"=\$pages;\"at\"=([:tonsec [:timestamp]] / 1000000000)})\n    :if ((!([:typeof (\$old->\"pages\")] ~ \"^(nil|nothing)\\\$\")) && ((\$old->\"generation\") != \$generation)) do={\n        :if ((\$old->\"pages\") > 0) do={:for i from=0 to=((\$old->\"pages\") - 1) do={\n            \$FHRDeleteState (\"cache-\" . \$key . \"-\" . (\$old->\"generation\") . \"-\" . \$i)\n        }}\n    }\n}\n:global FHRCacheRead do={\n    :global FHRReadJSON\n    :local key [:tostr \$1]; :local index [\$FHRReadJSON (\"cache-\" . \$key)]; :local out [:toarray \"\"]\n    :local pages [:tonum (\$index->\"pages\")]\n    :if (([:typeof \$pages] != \"nil\") && (\$pages > 0) && (\$pages < 1000)) do={\n        :for i from=0 to=(\$pages - 1) do={\n            :local rows [\$FHRReadJSON (\"cache-\" . \$key . \"-\" . (\$index->\"generation\") . \"-\" . \$i)]\n            :foreach row in=\$rows do={:if (!([:typeof (\$row->\"ip\")] ~ \"^(nil|nothing)\\\$\")) do={:set (\$out->[:len \$out]) \$row}}\n        }\n    }\n    :return {\"at\"=(\$index->\"at\");\"rows\"=\$out}\n}\n"
    :onerror err in={:local compiled [:parse $source]} do={:error ("Compile check failed: FHR.storage: " . $err)}
    :set ($FHRInstallSources->"storage") $source
}

{
    :global FHRInstallSources
    :local source "# Native RouterOS HTTPS and bounded probe workers.\n:global FHRHTTP do={\n    :global FHRConfig; :global FHRURL\n    :local req \$1; :local parsed [\$FHRURL (\$req->\"url\")]\n    :local u (\$parsed->\"url\"); :local ip [:tostr (\$req->\"ip\")]\n    :if ((\$FHRConfig->\"vrf\") != \"\") do={:set ip (\$ip . \"@\" . (\$FHRConfig->\"vrf\"))}\n    :local method [:tostr (\$req->\"method\")]; :if (\$method = \"\") do={:set method \"head\"}\n    :local output [:tostr (\$req->\"output\")]; :if (\$output = \"\") do={:set output \"user-with-headers\"}\n    :local seconds [:tonum (\$req->\"seconds\")]; :if ([:typeof \$seconds] = \"nil\") do={:set seconds (\$FHRConfig->\"probeSeconds\")}\n    :local extra [:tostr (\$req->\"headers\")]\n    :local hdr \"Accept-Encoding:identity,User-Agent:FastlyHosts-RouterOS/1.0.0\"\n    :if (\$extra != \"\") do={:set hdr (\$hdr . \",\" . \$extra)}\n    :local r [:toarray \"\"]; :local began [:timestamp]\n    :onerror err,attrs in={\n        :set r [/tool fetch url=\$u address=\$ip src-address=(\$FHRConfig->\"sourceAddress\") ip-type=ipv4 http-method=\$method http-max-redirect-count=0 http-header-field=\$hdr check-certificate=yes output=\$output dst-path=[:tostr (\$req->\"file\")] as-value idle-timeout=4s duration=[:totime (\$seconds . \"s\")]]\n        :set (\$r->\"requestOK\") true\n    } do={\n        :if ([:typeof \$attrs] = \"array\") do={:set r \$attrs}\n        :set (\$r->\"requestOK\") false; :set (\$r->\"error\") [:tostr \$err]\n    }\n    :set (\$r->\"wallMs\") ([:tonsec ([:timestamp] - \$began)] / 1000000)\n    :if ([:typeof (\$r->\"code\")] ~ \"^(nil|nothing)\\\$\") do={:set (\$r->\"code\") 0} else={:set (\$r->\"code\") [:tonum (\$r->\"code\")]}\n    :if ([:typeof (\$r->\"http-headers\")] ~ \"^(nil|nothing)\\\$\") do={:set (\$r->\"http-headers\") [:toarray \"\"]}\n    :return \$r\n}\n:global FHRText do={\n    # Metadata can exceed output=user's 64KB cap. Only metadata uses a scratch file.\n    :global FHRHTTP; :global FHRConfig; :global FHRDir\n    :local req \$1; :local path (\$FHRDir . \"/metadata.tmp\")\n    :set (\$req->\"method\") \"get\"; :set (\$req->\"output\") \"file\"; :set (\$req->\"file\") \$path; :set (\$req->\"seconds\") 20\n    :if ([:len [/file find where name=\$path]] > 0) do={/file remove [/file find where name=\$path]}\n    :local r [\$FHRHTTP \$req]; :local result \"\"; :local bad \"\"\n    :onerror e in={\n        :if (((\$r->\"requestOK\") != true) || ((\$r->\"status\") != \"finished\") || ((\$r->\"code\") != 200)) do={:error \"metadata HTTPS request failed\"}\n        :local id [/file find where name=\$path]\n        :local size [/file get \$id size]\n        :if ((\$size <= 0) || (\$size > (\$FHRConfig->\"maxTextBytes\"))) do={:error \"metadata exceeds configured size bound\"}\n        :local offset 0\n        :while (\$offset < \$size) do={\n            :local part [/file read file=\$path offset=\$offset chunk-size=32768 as-value]\n            :local data [:tostr (\$part->\"data\")]\n            :if ([:len \$data] = 0) do={:error \"empty metadata chunk\"}\n            :set result (\$result . \$data); :set offset (\$offset + [:len \$data])\n        }\n    } do={:set bad [:tostr \$e]}\n    :if ([:len [/file find where name=\$path]] > 0) do={/file remove [/file find where name=\$path]}\n    :if (\$bad != \"\") do={:error \$bad}\n    :return \$result\n}\n:global FHRTCP do={\n    # Short-lived native TCP probes. Never install Netwatch event scripts.\n    :global FHRConfig\n    :local ip [:tostr \$1]; :local id \"\"; :local answer {\"ok\"=false;\"us\"=0;\"typed\"=false}\n    :if ((\$FHRConfig->\"vrf\") != \"\") do={:set ip (\$ip . \"@\" . (\$FHRConfig->\"vrf\"))}\n    :onerror e in={\n        :set id [/tool netwatch add host=\$ip type=tcp-conn port=443 interval=1h timeout=2s thr-tcp-conn-time=2s start-delay=0s startup-delay=0s disabled=yes comment=\"FHR:temporary-tcp\" up-script=\"\" down-script=\"\" test-script=\"\"]\n        :if ((\$FHRConfig->\"sourceAddress\") != \"0.0.0.0\") do={/tool netwatch set \$id src-address=(\$FHRConfig->\"sourceAddress\")}\n        /tool netwatch enable \$id\n        :local deadline ([:timestamp] + 4s)\n        :while (([/tool netwatch get \$id done-tests] = 0) && ([:timestamp] < \$deadline)) do={:delay 50ms}\n        :if ([/tool netwatch get \$id status] = \"up\") do={\n            :set (\$answer->\"ok\") true\n            :local elapsed [/tool netwatch get \$id tcp-connect-time]\n            :if ([:typeof \$elapsed] = \"time\") do={\n                :set (\$answer->\"us\") ([:tonsec \$elapsed] / 1000); :set (\$answer->\"typed\") true\n            }\n        }\n    } do={}\n    :if (\$id != \"\") do={:onerror e in={/tool netwatch remove \$id} do={}}\n    :return \$answer\n}\n:global FHRProbe do={\n    :global FHRHTTP; :global FHRHeader; :global FHRPop; :global FHRSame24\n    :global FHRAllowed; :global FHRConfig; :global FHRTCP\n    :local svc \$1; :local base [:tostr \$2]; :local tcp \$3\n    :local ip [\$FHRSame24 \$base (\$svc->\"suffix\")]\n    :local u (\"https://\" . (\$svc->\"probeHost\") . (\$svc->\"probePath\"))\n    :local r [\$FHRHTTP ({\"url\"=\$u;\"ip\"=\$ip;\"method\"=\"head\"})]\n    :local code (\$r->\"code\"); :local valid false\n    :if (((\$svc->\"anyStatus\") = true) && (\$code >= 200) && (\$code < 500)) do={:set valid true}\n    :if (((\$r->\"requestOK\") = true) && (\$code >= 200) && (\$code < 400)) do={:set valid true}\n    :if (!\$valid) do={:return {\"ok\"=false;\"ip\"=\$ip;\"reason\"=\"TLS/HTTP\";\"code\"=\$code}}\n    :local pop [\$FHRPop [\$FHRHeader (\$r->\"http-headers\") \"x-served-by\"]]\n    :if ([:tostr (\$svc->\"popHost\")] != \"\") do={\n        :local q [\$FHRHTTP ({\"url\"=(\"https://\" . (\$svc->\"popHost\") . (\$svc->\"popPath\"));\"ip\"=[\$FHRSame24 \$ip (\$svc->\"popSuffix\")];\"method\"=\"head\"})]\n        :set pop [\$FHRPop [\$FHRHeader (\$q->\"http-headers\") \"x-served-by\"]]\n    }\n    :if (![\$FHRAllowed \$pop \"\"]) do={:return {\"ok\"=false;\"ip\"=\$ip;\"pop\"=\$pop;\"reason\"=\"excluded-or-unknown-POP\"}}\n    :local us ((\$r->\"wallMs\") * 1000); :local kind \"head\"\n    :if ((\$tcp = true) && ((\$FHRConfig->\"latencyProbe\") = \"tcp\")) do={\n        :local t [\$FHRTCP \$ip]\n        :if ((\$t->\"ok\") && (\$t->\"typed\")) do={:set us (\$t->\"us\"); :set kind \"tcp\"}\n    }\n    :return {\"ok\"=true;\"ip\"=\$ip;\"pop\"=\$pop;\"headMs\"=(\$r->\"wallMs\");\"latencyUs\"=\$us;\"latencyKind\"=\$kind;\"code\"=\$code}\n}\n:global FHRParallel do={\n    :global FHRConfig; :global FHRProbe\n    :global FHRWork; :global FHRWorkResults; :global FHRWorkToken\n    :local svc \$1; :local ips \$2; :local measure \$3\n    :local parallel (\$FHRConfig->\"parallel\"); :local results [:toarray \"\"]\n    :local active [:toarray \"\"]; :local next 0; :local done 0\n    :set FHRWork [:toarray \"\"]; :set FHRWorkResults [:toarray \"\"]\n    :set FHRWorkToken [:tostr [:tonsec [:timestamp]]]\n    :local token \$FHRWorkToken; :local fatal \"\"\n    :onerror e in={\n        :while ((\$next < [:len \$ips]) || ([:len \$active] > 0)) do={\n            :while ((\$next < [:len \$ips]) && ([:len \$active] < \$parallel)) do={\n                :local slot [:tostr \$next]\n                :set (\$FHRWork->\$slot) {\"svc\"=\$svc;\"ip\"=(\$ips->\$next);\"tcp\"=\$measure;\"token\"=\$token}\n                # Only a generated integer enters code. URLs and domains remain data.\n                :local worker (\":global FHRWork; :global FHRWorkResults; :global FHRWorkToken; :global FHRProbe; :local slot \\\"\" . \$slot . \"\\\"; :local w (\\\$FHRWork->\\\$slot); :local r {\\\"ok\\\"=false}; :onerror e in={ :set r [\\\$FHRProbe (\\\$w->\\\"svc\\\") (\\\$w->\\\"ip\\\") (\\\$w->\\\"tcp\\\")] } do={ :set (\\\$r->\\\"reason\\\") [:tostr \\\$e] }; :if (\\\$FHRWorkToken = (\\\$w->\\\"token\\\")) do={ :set (\\\$r->\\\"done\\\") true; :set (\\\$FHRWorkResults->\\\$slot) \\\$r }\")\n                :local job [:execute script=\$worker]\n                :set (\$active->\$slot) {\"id\"=\$job;\"started\"=[:timestamp]}\n                :set next (\$next + 1)\n            }\n            :local remaining [:toarray \"\"]\n            :foreach slot,job in=\$active do={\n                :local result (\$FHRWorkResults->\$slot)\n                :if ((\$result->\"done\") = true) do={\n                    :if ((\$result->\"ok\") = true) do={\n                        :set (\$results->[:len \$results]) \$result\n                        :if ((\$FHRConfig->\"verbose\") = true) do={:put (\"VALID \" . (\$svc->\"key\") . \" \" . (\$result->\"ip\") . \" POP=\" . (\$result->\"pop\"))}\n                    }\n                    :set done (\$done + 1)\n                } else={\n                    :if (([:timestamp] - (\$job->\"started\")) > [:totime (((\$FHRConfig->\"probeSeconds\") * 3 + 10) . \"s\")]) do={\n                        :onerror err in={/system script job remove (\$job->\"id\")} do={}\n                        :set done (\$done + 1)\n                        :log warning (\"FHR: probe worker timeout \" . (\$svc->\"key\") . \" \" . \$slot)\n                    } else={:set (\$remaining->\$slot) \$job}\n                }\n            }\n            :if (([:len \$remaining] < [:len \$active]) && ((\$done % 40) = 0)) do={:put (\"DISCOVER \" . (\$svc->\"key\") . \" \" . \$done . \"/\" . [:len \$ips] . \" nonSG=\" . [:len \$results])}\n            :set active \$remaining\n            :if ([:len \$active] > 0) do={:delay 100ms}\n        }\n    } do={:set fatal [:tostr \$e]}\n    :set FHRWorkToken \"\"\n    :foreach slot,job in=\$active do={:onerror e in={/system script job remove (\$job->\"id\")} do={}}\n    /tool netwatch remove [/tool netwatch find where comment=\"FHR:temporary-tcp\"]\n    :set FHRWork [:toarray \"\"]; :set FHRWorkResults [:toarray \"\"]\n    :if (\$fatal != \"\") do={:error \$fatal}\n    :return \$results\n}\n:global FHRResolveAll do={\n    :global FHRConfig\n    :local fhrHostName [:tostr \$1]; :local out [:toarray \"\"]; :local seen [:toarray \"\"]\n    :onerror e in={\n        :local ip \"\"\n        :if ((\$FHRConfig->\"resolver\") = \"\") do={:set ip [:tostr [:resolve domain-name=\$fhrHostName type=ipv4]]} else={:set ip [:tostr [:resolve domain-name=\$fhrHostName server=(\$FHRConfig->\"resolver\") type=ipv4]]}\n        :set (\$out->[:len \$out]) \$ip; :set (\$seen->\$ip) true\n    } do={}\n    :foreach row in=[/ip dns cache all print as-value where name=\$fhrHostName and type=\"A\"] do={\n        :local ip [:tostr (\$row->\"data\")]\n        :if ((\$ip != \"\") && ([:typeof (\$seen->\$ip)] ~ \"^(nil|nothing)\\\$\")) do={:set (\$out->[:len \$out]) \$ip; :set (\$seen->\$ip) true}\n    }\n    :return \$out\n}\n"
    :onerror err in={:local compiled [:parse $source]} do={:error ("Compile check failed: FHR.network: " . $err)}
    :set ($FHRInstallSources->"network") $source
}

{
    :global FHRInstallSources
    :local source "# Service-specific metadata adapters. All scoring and DNS writing are shared.\n:global FHRGitHubAsset do={\n    :global FHRConfig; :global FHRText; :global FHRURL\n    :local selected [:toarray \"\"]\n    :foreach repo in=(\$FHRConfig->\"releaseRepos\") do={\n        :onerror e in={\n            :if (!([:tostr \$repo] ~ \"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\\\$\")) do={:error \"invalid release repository\"}\n            :local body [\$FHRText ({\"url\"=(\"https://api.github.com/repos/\" . \$repo . \"/releases/latest\");\"headers\"=\"Accept:application/vnd.github+json\"})]\n            :local data [:deserialize from=json options=json.no-string-conversion value=\$body]\n            :local largest 0; :local public \"\"\n            :foreach asset in=(\$data->\"assets\") do={\n                :local n [:tonum (\$asset->\"size\")]\n                :if ((\$n > \$largest) && ([:tostr (\$asset->\"browser_download_url\")] != \"\")) do={\n                    :set largest \$n; :set public [:tostr (\$asset->\"browser_download_url\")]\n                }\n            }\n            :if ((\$largest >= 262144) && (\$public != \"\")) do={\n                :local parsed [\$FHRURL \$public]\n                :if ((\$parsed->\"host\") != \"github.com\") do={:error \"unexpected release metadata host\"}\n                :set selected {\"mode\"=\"github\";\"public\"=\$public;\"size\"=\$largest;\"host\"=\"release-assets.githubusercontent.com\";\"suffix\"=133}\n            }\n        } do={:put (\"METADATA github: \" . \$repo . \" unavailable: \" . \$e)}\n        :if ([:len \$selected] > 0) do={:break}\n    }\n    :return \$selected\n}\n:global FHRSignedURL do={\n    :global FHRHTTP; :global FHRHeader; :global FHRURL\n    :local u [:tostr \$1]\n    :for hop from=0 to=4 do={\n        :local parsed [\$FHRURL \$u]\n        :if ((\$parsed->\"host\") = \"release-assets.githubusercontent.com\") do={:return \$u}\n        :if ((\$parsed->\"host\") != \"github.com\") do={:error \"unexpected release redirect host\"}\n        :local r [\$FHRHTTP ({\"url\"=\$u;\"method\"=\"head\";\"seconds\"=15})]\n        :local code (\$r->\"code\")\n        :if (!((\$code = 301) || (\$code = 302) || (\$code = 303) || (\$code = 307) || (\$code = 308))) do={:error \"GitHub did not return a release redirect\"}\n        :local next [\$FHRHeader (\$r->\"http-headers\") \"location\"]\n        :if ([:pick \$next 0 1] = \"/\") do={:set next (\"https://github.com\" . \$next)}\n        :local parsedNext [\$FHRURL \$next]\n        :set u (\$parsedNext->\"url\")\n    }\n    :error \"too many release redirects\"\n}\n:global FHRTwitchAsset do={\n    :global FHRText; :global FHRSame24; :global FHRURL\n    :local rows \$1; :local html \"\"; :local tries 0\n    :foreach row in=\$rows do={\n        :if ((\$html = \"\") && (\$tries < 5)) do={\n            :set tries (\$tries + 1)\n            :onerror e in={:set html [\$FHRText ({\"url\"=\"https://www.twitch.tv/\";\"ip\"=[\$FHRSame24 (\$row->\"ip\") 214]})]} do={}\n        }\n    }\n    :if (\$html = \"\") do={:onerror e in={:set html [\$FHRText ({\"url\"=\"https://www.twitch.tv/\"})]} do={}}\n    :if (\$html = \"\") do={:error \"Twitch homepage unavailable\"}\n    :local prefix \"https://assets.twitch.tv/assets/\"; :local offset 0; :local first \"\"; :local preferred \"\"\n    :while (\$offset < [:len \$html]) do={\n        :local start [:find \$html \$prefix \$offset]\n        :if ([:typeof \$start] = \"nil\") do={:break}\n        :local end [:find \$html \".js\" \$start]\n        :if ([:typeof \$end] = \"nil\") do={:break}\n        :local candidate [:pick \$html \$start (\$end + 3)]\n        :if (([:len \$candidate] < 2048) && (!(\$candidate ~ \"[\\r\\n<>\\\"' ]\"))) do={\n            :local parsed [\$FHRURL \$candidate]\n            :if ((\$parsed->\"host\") = \"assets.twitch.tv\") do={\n                :if (\$first = \"\") do={:set first \$candidate}\n                :if (([:typeof [:find \$candidate \"nomodulePolyfills\"]] != \"nil\") || ([:typeof [:find \$candidate \"/core-\"]] != \"nil\")) do={:set preferred \$candidate}\n            }\n        }\n        :set offset (\$end + 3)\n    }\n    :if (\$preferred != \"\") do={:return \$preferred}\n    :if (\$first != \"\") do={:return \$first}\n    :error \"Twitch homepage has no usable assets.twitch.tv JS URL\"\n}\n:global FHRBenchmark do={\n    :global FHRGitHubAsset; :global FHRSignedURL; :global FHRTwitchAsset; :global FHRURL\n    :local svc \$1; :local rows \$2; :local result [:toarray \"\"]\n    :onerror e in={\n        :if ((\$svc->\"mode\") = \"github\") do={\n            :set result [\$FHRGitHubAsset]\n            :if ([:len \$result] = 0) do={:error \"no release asset metadata\"}\n            :set (\$result->\"url\") [\$FHRSignedURL (\$result->\"public\")]\n        } else={\n            :local u [:tostr (\$svc->\"testURL\")]\n            :if (((\$svc->\"mode\") = \"twitch\") && (\$u = \"\")) do={:set u [\$FHRTwitchAsset \$rows]}\n            :if (\$u != \"\") do={\n                :local parsed [\$FHRURL \$u]\n                :local suffix (\$svc->\"suffix\")\n                :if ((\$svc->\"mode\") = \"twitch\") do={\n                    :if ((\$parsed->\"host\") != \"assets.twitch.tv\") do={:error \"Twitch benchmark must be on assets.twitch.tv\"}\n                    :set suffix 214\n                } else={\n                    :if ((\$parsed->\"host\") != (\$svc->\"probeHost\")) do={:error \"custom benchmark must stay on its profile hostname\"}\n                }\n                :set result {\"url\"=\$u;\"host\"=(\$parsed->\"host\");\"suffix\"=\$suffix;\"mode\"=(\$svc->\"mode\")}\n            }\n        }\n    } do={\n        :put (\"BENCHMARK \" . (\$svc->\"key\") . \": unavailable; \" . \$e)\n        :set result [:toarray \"\"]\n    }\n    :return \$result\n}\n:global FHRPrepareSample do={\n    :global FHRHTTP; :global FHRHeader; :global FHRPop; :global FHRAllowed\n    :global FHRSame24; :global FHRRange; :global FHRConfig\n    :local bench \$1; :local row \$2\n    :local ip [\$FHRSame24 (\$row->\"ip\") (\$bench->\"suffix\")]\n    :local r [\$FHRHTTP ({\"url\"=(\$bench->\"url\");\"ip\"=\$ip;\"method\"=\"head\";\"seconds\"=10})]\n    :if (((\$r->\"code\") != 200) || ((\$r->\"requestOK\") != true)) do={:return {\"ok\"=false}}\n    :local observed [\$FHRPop [\$FHRHeader (\$r->\"http-headers\") \"x-served-by\"]]\n    :if ((\$observed != \"?\") && (![\$FHRAllowed \$observed \"\"])) do={:return {\"ok\"=false;\"excluded\"=true}}\n    :local encoding [:convert transform=lc [\$FHRHeader (\$r->\"http-headers\") \"content-encoding\"]]\n    :if ((\$encoding != \"\") && (\$encoding != \"identity\")) do={:return {\"ok\"=false;\"reason\"=\"server ignored Accept-Encoding:identity\"}}\n    :local length [:tonum [\$FHRHeader (\$r->\"http-headers\") \"content-length\"]]\n    :local requested (\$FHRConfig->\"sampleBytes\")\n    :if (([:typeof \$length] != \"nil\") && (\$length > 0) && (\$length <= \$requested)) do={\n        :return {\"ok\"=true;\"ip\"=\$ip;\"bytes\"=\$length;\"range\"=false;\"pop\"=\$observed}\n    }\n    # Prove byte-range support before requesting part of a potentially huge asset.\n    :local q [\$FHRHTTP ({\"url\"=(\$bench->\"url\");\"ip\"=\$ip;\"method\"=\"get\";\"headers\"=\"Range:bytes=0-1023\";\"seconds\"=10})]\n    :if (((\$q->\"requestOK\") != true) || ((\$q->\"code\") != 206)) do={:return {\"ok\"=false;\"reason\"=\"Range unsupported\"}}\n    :local cr [\$FHRRange [\$FHRHeader (\$q->\"http-headers\") \"content-range\"]]\n    :if (([:len \$cr] = 0) || ((\$cr->\"first\") != 0)) do={:return {\"ok\"=false}}\n    :if ((\$cr->\"total\") < \$requested) do={:set requested (\$cr->\"total\")}\n    :set observed [\$FHRPop [\$FHRHeader (\$q->\"http-headers\") \"x-served-by\"]]\n    :if ((\$observed != \"?\") && (![\$FHRAllowed \$observed \"\"])) do={:return {\"ok\"=false;\"excluded\"=true}}\n    :return {\"ok\"=true;\"ip\"=\$ip;\"bytes\"=\$requested;\"range\"=true;\"pop\"=\$observed}\n}\n:global FHRMeasure do={\n    :global FHRConfig; :global FHRHTTP; :global FHRSignedURL\n    :global FHRPrepareSample; :global FHRHeader; :global FHRPop; :global FHRAllowed\n    :local svc \$1; :local rows \$2; :local bench \$3\n    :local stats [:toarray \"\"]; :local prepared [:toarray \"\"]\n    :if ([:len \$bench] = 0) do={:return {\"samples\"=\$stats;\"bench\"=\$bench;\"measured\"=false}}\n    :foreach row in=\$rows do={\n        :local ip (\$row->\"ip\")\n        :set (\$prepared->\$ip) [\$FHRPrepareSample \$bench \$row]\n        :set (\$stats->\$ip) {\"rates\"=[:toarray \"\"];\"valid\"=0;\"blocked\"=false}\n    }\n    :for round from=1 to=(\$FHRConfig->\"rounds\") do={\n        :if ((\$bench->\"mode\") = \"github\") do={\n            :onerror e in={:set (\$bench->\"url\") [\$FHRSignedURL (\$bench->\"public\")]} do={:error \"cannot refresh signed release URL\"}\n        }\n        :put (\"SAMPLE \" . (\$svc->\"key\") . \" round=\" . \$round . \"/\" . (\$FHRConfig->\"rounds\"))\n        :if ([:len \$rows] > 0) do={:for n from=0 to=([:len \$rows] - 1) do={\n            :local row (\$rows->((\$n + \$round - 1) % [:len \$rows])); :local ip (\$row->\"ip\")\n            :local prep (\$prepared->\$ip); :local s (\$stats->\$ip); :local rate 0; :local code 0; :local ms 0\n            :if (((\$prep->\"ok\") = true) && ((\$s->\"blocked\") != true)) do={\n                :local header \"\"\n                :if ((\$prep->\"range\") = true) do={:set header (\"Range:bytes=0-\" . ((\$prep->\"bytes\") - 1))}\n                :local r [\$FHRHTTP ({\"url\"=(\$bench->\"url\");\"ip\"=(\$prep->\"ip\");\"method\"=\"get\";\"output\"=\"none\";\"headers\"=\$header;\"seconds\"=(\$FHRConfig->\"sampleSeconds\")})]\n                :set code (\$r->\"code\"); :set ms (\$r->\"wallMs\")\n                :local wanted 200; :if ((\$prep->\"range\") = true) do={:set wanted 206}\n                :local kib [:tonum (\$r->\"downloaded\")]\n                :local expected ((\$prep->\"bytes\") / 1024)\n                :local observed [\$FHRPop [\$FHRHeader (\$r->\"http-headers\") \"x-served-by\"]]\n                :if ((\$observed != \"?\") && (![\$FHRAllowed \$observed \"\"])) do={:set (\$s->\"blocked\") true}\n                :if (((\$r->\"requestOK\") = true) && ((\$r->\"status\") = \"finished\") && (\$code = \$wanted) && ([:typeof \$kib] != \"nil\") && (\$kib >= (\$expected - 1)) && (\$ms > 0) && ((\$s->\"blocked\") != true)) do={\n                    :set rate (((\$prep->\"bytes\") * 8000) / \$ms)\n                    :set (\$s->\"valid\") ((\$s->\"valid\") + 1)\n                }\n            }\n            :set (\$s->\"rates\") ((\$s->\"rates\"), \$rate); :set (\$stats->\$ip) \$s\n            :put (\"  \" . \$ip . \" HTTP=\" . \$code . \" wallMs=\" . \$ms . \" approxKbps=\" . (\$rate / 1000))\n        }}\n    }\n    :return {\"samples\"=\$stats;\"bench\"=\$bench;\"measured\"=true}\n}\n"
    :onerror err in={:local compiled [:parse $source]} do={:error ("Compile check failed: FHR.benchmarks: " . $err)}
    :set ($FHRInstallSources->"benchmarks") $source
}

{
    :global FHRInstallSources
    :local source ":global FHRRanges do={\n    :global FHRHTTP; :global FHRConfig; :global FHRCIDR\n    :local ranges [:toarray \"\"]\n    :onerror e in={\n        :local r [\$FHRHTTP ({\"url\"=\"https://api.fastly.com/public-ip-list\";\"method\"=\"get\";\"output\"=\"user\";\"seconds\"=15})]\n        :if (((\$r->\"requestOK\") != true) || ((\$r->\"code\") != 200)) do={:error \"Fastly API request failed\"}\n        :local data [:deserialize from=json options=json.no-string-conversion value=(\$r->\"data\")]\n        :foreach cidr in=(\$data->\"addresses\") do={:local checked [\$FHRCIDR \$cidr]; :set ranges (\$ranges, [:tostr \$cidr])}\n    } do={:put (\"Fastly API unavailable; using bundled official snapshot: \" . \$e)}\n    :if ([:len \$ranges] = 0) do={:set ranges (\$FHRConfig->\"fallbackCIDRs\")}\n    :return \$ranges\n}\n:global FHRDiscover do={\n    :global FHRConfig; :global FHRBlocks; :global FHRSame24; :global FHRInRanges\n    :global FHRResolveAll; :global FHRParallel; :global FHRCacheRead; :global FHRCacheWrite\n    :local svc \$1; :local ranges \$2; :local refresh \$3; :local cacheOnly \$4\n    :local key (\$svc->\"key\"); :local cache [\$FHRCacheRead \$key]\n    :local age 999999999; :local rows (\$cache->\"rows\")\n    :if (!([:typeof (\$cache->\"at\")] ~ \"^(nil|nothing)\\\$\")) do={:set age (([:tonsec [:timestamp]] / 1000000000) - [:tonum (\$cache->\"at\")])}\n    :local ips [:toarray \"\"]; :local seen [:toarray \"\"]; :local fromCache false\n    :if ((\$refresh != true) && ([:len \$rows] > 0) && (\$age >= 0) && (\$age <= (\$FHRConfig->\"cacheSeconds\"))) do={:set fromCache true}\n    :if (\$cacheOnly = true) do={\n        :if (([:len \$rows] = 0) || (\$age < 0) || (\$age > (\$FHRConfig->\"cacheStaleSeconds\"))) do={:error \"no usable scan cache; run apply or region once\"}\n        :set fromCache true\n    }\n    :if (\$fromCache) do={\n        :foreach row in=\$rows do={\n            :local ip [:tostr (\$row->\"ip\")]\n            :if ([:typeof (\$seen->\$ip)] ~ \"^(nil|nothing)\\\$\") do={:set (\$ips->[:len \$ips]) \$ip; :set (\$seen->\$ip) true}\n        }\n        :put (\"CACHE \" . \$key . \": revalidating \" . [:len \$ips] . \" candidates\")\n    } else={\n        :local blocks [\$FHRBlocks \$ranges (\$FHRConfig->\"maxBlocks\")]\n        # Prioritization only changes order. No stride sampling and no silent cap.\n        :foreach block in=(\$FHRConfig->\"priorityBlocks\") do={\n            :local ip [\$FHRSame24 \$block (\$svc->\"suffix\")]\n            :if ([\$FHRInRanges \$ip \$ranges]) do={:set (\$ips->[:len \$ips]) \$ip; :set (\$seen->\$ip) true}\n        }\n        :foreach block in=\$blocks do={\n            :local ip [\$FHRSame24 \$block (\$svc->\"suffix\")]\n            :if (([:typeof (\$seen->\$ip)] ~ \"^(nil|nothing)\\\$\") && [\$FHRInRanges \$ip \$ranges]) do={:set (\$ips->[:len \$ips]) \$ip; :set (\$seen->\$ip) true}\n        }\n        :put (\"FULL DISCOVERY \" . \$key . \": \" . [:len \$ips] . \" service IPs from \" . [:len \$blocks] . \" /24 blocks\")\n    }\n    # The service's actual DNS can use dedicated ranges absent from the Fastly API.\n    :foreach base in=[\$FHRResolveAll (\$svc->\"probeHost\")] do={\n        :local ip [\$FHRSame24 \$base (\$svc->\"suffix\")]\n        :if ([:typeof (\$seen->\$ip)] ~ \"^(nil|nothing)\\\$\") do={:set (\$ips->[:len \$ips]) \$ip; :set (\$seen->\$ip) true}\n    }\n    :local verified [\$FHRParallel \$svc \$ips true]\n    :if (([:len \$verified] = 0) && \$fromCache && (\$cacheOnly != true)) do={\n        # One bounded fallback to the full official candidate space, not recursion.\n        :set ips [:toarray \"\"]; :set seen [:toarray \"\"]\n        :foreach block in=[\$FHRBlocks \$ranges (\$FHRConfig->\"maxBlocks\")] do={\n            :local ip [\$FHRSame24 \$block (\$svc->\"suffix\")]\n            :if ([\$FHRInRanges \$ip \$ranges]) do={:set (\$ips->[:len \$ips]) \$ip}\n        }\n        :put (\"CACHE \" . \$key . \" exhausted; expanding to all service IPs\")\n        :set verified [\$FHRParallel \$svc \$ips true]\n        :set fromCache false\n    }\n    :if ([:len \$verified] > 0) do={\n        # Do not renew a cache's discovery age just because its survivors were rechecked.\n        :if (!\$fromCache) do={:onerror e in={\$FHRCacheWrite \$key \$verified} do={:log warning (\"FHR: cache save failed for \" . \$key . \": \" . \$e)}}\n    }\n    :put (\"DISCOVERY COMPLETE \" . \$key . \": \" . [:len \$verified] . \" eligible non-Singapore routes\")\n    :return \$verified\n}\n:global FHRShortlist do={\n    :global FHRConfig; :global FHRRank; :global FHRAllowed; :global FHRReadJSON\n    :local svc \$1; :local rows \$2; :local region [:tostr \$3]; :local full \$4\n    :local eligible [:toarray \"\"]; :local nearest 9223372036854775807\n    :foreach row in=\$rows do={\n        :if ([\$FHRAllowed (\$row->\"pop\") \$region]) do={\n            :set (\$eligible->[:len \$eligible]) \$row\n            :if (((\$row->\"latencyKind\") = \"tcp\") && ((\$row->\"latencyUs\") < \$nearest)) do={:set nearest (\$row->\"latencyUs\")}\n        }\n    }\n    :local band [:toarray \"\"]\n    :foreach row in=\$eligible do={\n        :if ((\$full = true) || (\$region != \"\") || ((\$row->\"latencyKind\") != \"tcp\") || ((\$row->\"latencyUs\") <= (\$nearest + (\$FHRConfig->\"nearMarginMs\") * 1000))) do={:set (\$band->[:len \$band]) \$row}\n    }\n    :local ranked [\$FHRRank \$band [:toarray \"\"]]\n    :local out [:toarray \"\"]; :local seen [:toarray \"\"]\n    :local current [\$FHRReadJSON (\"current-\" . (\$svc->\"key\"))]\n    :foreach row in=\$eligible do={\n        :if ((\$row->\"ip\") = (\$current->\"ip\")) do={:set (\$out->[:len \$out]) \$row; :set (\$seen->(\$row->\"ip\")) true}\n    }\n    :foreach row in=\$ranked do={\n        :if (([:len \$out] < (\$FHRConfig->\"shortlist\")) && ([:typeof (\$seen->(\$row->\"ip\"))] ~ \"^(nil|nothing)\\\$\")) do={\n            :set (\$out->[:len \$out]) \$row; :set (\$seen->(\$row->\"ip\")) true\n        }\n    }\n    :return \$out\n}\n:global FHRRegionCode do={\n    :global FHRTrim\n    :local text [:convert transform=uc [\$FHRTrim \$1]]\n    :if ((\$text = \"\") || (\$text = \"AUTO\")) do={:return \"\"}\n    # Codes are unambiguous. Common city aliases are convenience mappings.\n    :local aliases {\"TOKYO\"=\"NRT\";\"OSAKA\"=\"ITM\";\"SEOUL\"=\"ICN\";\"HONG KONG\"=\"HKG\";\"SINGAPORE\"=\"SIN\";\"TAIPEI\"=\"TPE\";\"LOS ANGELES\"=\"BUR\";\"LONDON\"=\"LHR\";\"NEW YORK\"=\"LGA\";\"DALLAS\"=\"DFW\";\"CHENNAI\"=\"MAA\"}\n    :if (!([:typeof (\$aliases->\$text)] ~ \"^(nil|nothing)\\\$\")) do={:set text (\$aliases->\$text)}\n    :if (!(\$text ~ \"^[A-Z]{3}\\\$\")) do={:error \"use a three-letter POP code, e.g. NRT, ITM or ICN\"}\n    :return \$text\n}\n"
    :onerror err in={:local compiled [:parse $source]} do={:error ("Compile check failed: FHR.discovery: " . $err)}
    :set ($FHRInstallSources->"discovery") $source
}

{
    :global FHRInstallSources
    :local source "# Managed exact A records only. No changes to DNS servers, AAAA, NAT, mangle or routes.\n:global FHROwned do={:return ([:pick [:tostr \$1] 0 9] = \"FHR:auto:\")}\n:global FHRLegacy do={\n    :local c [:tostr \$1]\n    :return (([:pick \$c 0 15] = \"FastlyROS:auto:\") || (\$c = \"Fastly-Pilot-Raw\") || (\$c = \"Fastly-Pilot-raw\"))\n}\n:global FHRSnapshot do={\n    :local out [:toarray \"\"]\n    :foreach id in=\$1 do={\n        :set (\$out->[:len \$out]) {\"name\"=[/ip dns static get \$id name];\"address\"=[:tostr [/ip dns static get \$id address]];\"ttl\"=[:tostr [/ip dns static get \$id ttl]];\"comment\"=[/ip dns static get \$id comment];\"disabled\"=[/ip dns static get \$id disabled]}\n    }\n    :return \$out\n}\n:global FHRRestoreSnapshot do={\n    :global FHROwned; :global FHRLegacy; :global FHRHostValid\n    :local domains \$1; :local records \$2\n    :foreach fhrHostName in=\$domains do={\n        :if (![\$FHRHostValid \$fhrHostName]) do={:error \"unsafe journal hostname\"}\n        :foreach id in=[/ip dns static find where name=\$fhrHostName and type=\"A\"] do={\n            :local c [/ip dns static get \$id comment]\n            :if ([\$FHROwned \$c]) do={/ip dns static remove \$id}\n        }\n    }\n    :foreach r in=\$records do={\n        :local h [:tostr (\$r->\"name\")]; :local c [:tostr (\$r->\"comment\")]\n        :if ((![\$FHRHostValid \$h]) || (!([\$FHROwned \$c] || [\$FHRLegacy \$c]))) do={:error \"journal contains an unmanaged record\"}\n        :local included false; :foreach domain in=\$domains do={:if (\$h = \$domain) do={:set included true}}\n        :if (!\$included) do={:error \"journal record outside transaction scope\"}\n        :local matches [/ip dns static find where name=\$h and type=\"A\" and comment=\$c]\n        :if ([:len \$matches] > 0) do={\n            /ip dns static set \$matches address=(\$r->\"address\") ttl=[:totime (\$r->\"ttl\")] disabled=(\$r->\"disabled\")\n        } else={\n            /ip dns static add name=\$h type=A address=(\$r->\"address\") ttl=[:totime (\$r->\"ttl\")] comment=\$c disabled=(\$r->\"disabled\") match-subdomain=no\n        }\n    }\n    /ip dns cache flush\n}\n:global FHRRecover do={\n    :global FHRReadJSON; :global FHRWriteJSON; :global FHRDeleteState; :global FHRRestoreSnapshot\n    :local tx [\$FHRReadJSON \"transaction\"]\n    :if ([:len \$tx] > 0) do={\n        :put \"RECOVERY: restoring the interrupted DNS transaction\"\n        \$FHRRestoreSnapshot (\$tx->\"domains\") (\$tx->\"before\")\n        :local key [:tostr (\$tx->\"key\")]\n        :if (\$key != \"\") do={\n            :if ([:len (\$tx->\"oldCurrent\")] > 0) do={\$FHRWriteJSON (\"current-\" . \$key) (\$tx->\"oldCurrent\")} else={\$FHRDeleteState (\"current-\" . \$key)}\n            :if ([:len (\$tx->\"oldPrevious\")] > 0) do={\$FHRWriteJSON (\"previous-\" . \$key) (\$tx->\"oldPrevious\")} else={\$FHRDeleteState (\"previous-\" . \$key)}\n        }\n        \$FHRDeleteState \"transaction\"\n    }\n}\n:global FHRPreflight do={\n    :global FHRProbe; :global FHRHTTP; :global FHRHeader; :global FHRPop\n    :global FHRAllowed; :global FHRSame24; :global FHRURL\n    :local svc \$1; :local row \$2; :local bench \$3; :local region \$4\n    :local primary [\$FHRProbe \$svc (\$row->\"ip\") false]\n    :if (((\$primary->\"ok\") != true) || (![\$FHRAllowed (\$primary->\"pop\") \$region])) do={:return {\"ok\"=false}}\n    :if (((\$svc->\"mode\") = \"via\") && ((\$primary->\"pop\") != (\$row->\"donorPOP\"))) do={:return {\"ok\"=false}}\n    :foreach fhrHostName,suffix in=(\$svc->\"hosts\") do={\n        :local url (\"https://\" . \$fhrHostName . (\$svc->\"paths\"->\$fhrHostName))\n        :if (([:len \$bench] > 0) && ((\$bench->\"host\") = \$fhrHostName)) do={:set url (\$bench->\"url\")}\n        :local r [\$FHRHTTP ({\"url\"=\$url;\"ip\"=[\$FHRSame24 (\$row->\"ip\") \$suffix];\"method\"=\"head\";\"seconds\"=10})]\n        :local code (\$r->\"code\")\n        # Generic API roots may legitimately return 403/404/405. A received HTTP\n        # status still proves TLS passed; the profile's content probe is separate.\n        :if ((\$code < 200) || (\$code >= 500)) do={:return {\"ok\"=false;\"host\"=\$fhrHostName;\"reason\"=\"alias TLS/HTTP\"}}\n        :if (([:len \$bench] > 0) && ((\$bench->\"host\") = \$fhrHostName) && ((\$code < 200) || (\$code >= 300))) do={:return {\"ok\"=false;\"host\"=\$fhrHostName;\"reason\"=\"benchmark alias invalid\"}}\n        :local pop [\$FHRPop [\$FHRHeader (\$r->\"http-headers\") \"x-served-by\"]]\n        :if ((\$pop != \"?\") && (![\$FHRAllowed \$pop \$region])) do={:return {\"ok\"=false;\"host\"=\$fhrHostName;\"reason\"=\"alias POP excluded or outside region\"}}\n    }\n    :return {\"ok\"=true;\"pop\"=(\$primary->\"pop\")}\n}\n:global FHRCommit do={\n    :global FHRConfig; :global FHRSame24; :global FHROwned; :global FHRLegacy\n    :global FHRSnapshot; :global FHRReadJSON; :global FHRWriteJSON; :global FHRDeleteState; :global FHRRestoreSnapshot\n    :local svc \$1; :local chosen \$2\n    :local key (\$svc->\"key\"); :local domains [:toarray \"\"]; :local oldIds [:toarray \"\"]\n    :local baseline [\$FHRReadJSON \"baseline\"]; :local changed false\n    :foreach fhrHostName,suffix in=(\$svc->\"hosts\") do={\n        :set (\$domains->[:len \$domains]) \$fhrHostName\n        :local legacyIds [:toarray \"\"]; :local already false\n        :foreach rule in=[/ip dns static print as-value where disabled=no] do={\n            :local typ [:tostr (\$rule->\"type\")]\n            :if ((\$typ = \"A\") || (\$typ = \"FWD\") || (\$typ = \"CNAME\") || (\$typ = \"NXDOMAIN\")) do={\n                :local re [:tostr (\$rule->\"regexp\")]\n                :if ((\$re != \"\") && (\$fhrHostName ~ \$re)) do={:error (\"unmanaged DNS regexp matches \" . \$fhrHostName . \"; not overwritten\")}\n                :if (([:tostr (\$rule->\"name\")] = \$fhrHostName) && (\$typ != \"A\")) do={:error (\"existing non-A static rule owns \" . \$fhrHostName)}\n            }\n        }\n        :foreach id in=[/ip dns static find where name=\$fhrHostName and type=\"A\"] do={\n            :local c [/ip dns static get \$id comment]\n            :if ([\$FHROwned \$c]) do={\n                :set (\$oldIds->[:len \$oldIds]) \$id\n                :if (([:tostr [/ip dns static get \$id address]] = [\$FHRSame24 (\$chosen->\"ip\") \$suffix]) && ([/ip dns static get \$id disabled] = false)) do={:set already true}\n            } else={\n                :if (((\$FHRConfig->\"adoptLegacy\") = true) && [\$FHRLegacy \$c]) do={:set (\$oldIds->[:len \$oldIds]) \$id; :set (\$legacyIds->[:len \$legacyIds]) \$id; :set changed true} else={\n                    :if ([/ip dns static get \$id disabled] = false) do={:error (\"unmanaged static A record for \" . \$fhrHostName . \"; not overwritten\")}\n                }\n            }\n        }\n        :if (!\$already) do={:set changed true}\n        :if ([:typeof (\$baseline->\$fhrHostName)] ~ \"^(nil|nothing)\\\$\") do={:set (\$baseline->\$fhrHostName) [\$FHRSnapshot \$legacyIds]}\n    }\n    :if (!\$changed) do={\n        :put (\"KEPT DNS \" . \$key . \" -> \" . (\$chosen->\"ip\") . \" POP=\" . (\$chosen->\"pop\"))\n        \$FHRWriteJSON (\"current-\" . \$key) ({\"ip\"=(\$chosen->\"ip\");\"pop\"=(\$chosen->\"pop\");\"at\"=([:tonsec [:timestamp]] / 1000000000);\"hosts\"=(\$svc->\"hosts\")})\n        :return false\n    }\n    :local before [\$FHRSnapshot \$oldIds]\n    :local oldCurrent [\$FHRReadJSON (\"current-\" . \$key)]\n    :local oldPrevious [\$FHRReadJSON (\"previous-\" . \$key)]\n    \$FHRWriteJSON \"baseline\" \$baseline\n    \$FHRWriteJSON \"transaction\" ({\"domains\"=\$domains;\"before\"=\$before;\"key\"=\$key;\"oldCurrent\"=\$oldCurrent;\"oldPrevious\"=\$oldPrevious})\n    :local created [:toarray \"\"]; :local errorText \"\"\n    :onerror e in={\n        :foreach fhrHostName,suffix in=(\$svc->\"hosts\") do={\n            :local ip [\$FHRSame24 (\$chosen->\"ip\") \$suffix]\n            :local id [/ip dns static add name=\$fhrHostName type=A address=\$ip ttl=[:totime (\$FHRConfig->\"dnsTTL\")] disabled=yes match-subdomain=no comment=(\"FHR:auto:\" . \$key . \":\" . \$fhrHostName)]\n            :set (\$created->[:len \$created]) \$id\n        }\n        :foreach id in=\$oldIds do={/ip dns static disable \$id}\n        :foreach id in=\$created do={/ip dns static enable \$id}\n        :foreach id in=\$created do={:if ([/ip dns static get \$id disabled] = true) do={:error \"DNS activation verification failed\"}}\n        :foreach id in=\$oldIds do={/ip dns static remove \$id}\n        \$FHRWriteJSON (\"previous-\" . \$key) ({\"rows\"=\$before;\"current\"=\$oldCurrent})\n        \$FHRWriteJSON (\"current-\" . \$key) ({\"ip\"=(\$chosen->\"ip\");\"pop\"=(\$chosen->\"pop\");\"at\"=([:tonsec [:timestamp]] / 1000000000);\"hosts\"=(\$svc->\"hosts\")})\n        \$FHRDeleteState \"transaction\"\n    } do={:set errorText [:tostr \$e]}\n    :if (\$errorText != \"\") do={\n        \$FHRRestoreSnapshot \$domains \$before\n        :if ([:len \$oldCurrent] > 0) do={\$FHRWriteJSON (\"current-\" . \$key) \$oldCurrent} else={\$FHRDeleteState (\"current-\" . \$key)}\n        :if ([:len \$oldPrevious] > 0) do={\$FHRWriteJSON (\"previous-\" . \$key) \$oldPrevious} else={\$FHRDeleteState (\"previous-\" . \$key)}\n        \$FHRDeleteState \"transaction\"\n        :error (\"DNS transaction rolled back: \" . \$errorText)\n    }\n    /ip dns cache flush\n    :put (\"APPLIED \" . \$key . \" -> \" . (\$chosen->\"ip\") . \" POP=\" . (\$chosen->\"pop\") . \" aliases=\" . [:len \$domains])\n    :log info (\"FHR applied \" . \$key . \" \" . (\$chosen->\"ip\") . \" \" . (\$chosen->\"pop\"))\n    :return true\n}\n:global FHRRestore do={\n    :global FHRProfiles; :global FHRReadJSON; :global FHRDeleteState; :global FHRWriteJSON; :global FHRRestoreSnapshot\n    :local service [:tostr \$1]; :local baseline [\$FHRReadJSON \"baseline\"]\n    :local domains [:toarray \"\"]; :local records [:toarray \"\"]; :local keep [:toarray \"\"]\n    :foreach fhrHostName,rows in=\$baseline do={\n        :local include (\$service = \"\")\n        :if (\$service != \"\") do={:if (!([:typeof (\$FHRProfiles->\$service->\"hosts\"->\$fhrHostName)] ~ \"^(nil|nothing)\\\$\")) do={:set include true}}\n        :if (\$include) do={:set (\$domains->[:len \$domains]) \$fhrHostName; :foreach row in=\$rows do={:set (\$records->[:len \$records]) \$row}} else={:set (\$keep->\$fhrHostName) \$rows}\n    }\n    # Also remove managed entries after a lost baseline; never remove foreign records.\n    :foreach r in=[/ip dns static print as-value where type=\"A\"] do={\n        :local c [:tostr (\$r->\"comment\")]\n        :if (([:pick \$c 0 9] = \"FHR:auto:\") && ((\$service = \"\") || ([:pick \$c 0 (10 + [:len \$service])] = (\"FHR:auto:\" . \$service . \":\")))) do={\n            :local fhrHostName [:tostr (\$r->\"name\")]; :local seen false\n            :foreach d in=\$domains do={:if (\$d = \$fhrHostName) do={:set seen true}}\n            :if (!\$seen) do={:set (\$domains->[:len \$domains]) \$fhrHostName}\n        }\n    }\n    \$FHRRestoreSnapshot \$domains \$records\n    \$FHRWriteJSON \"baseline\" \$keep\n    :foreach key,svc in=\$FHRProfiles do={:if ((\$service = \"\") || (\$service = \$key)) do={\$FHRDeleteState (\"current-\" . \$key); \$FHRDeleteState (\"previous-\" . \$key)}}\n    :put (\"RESTORED \" . [:len \$domains] . \" exact DNS names\")\n}\n"
    :onerror err in={:local compiled [:parse $source]} do={:error ("Compile check failed: FHR.dns: " . $err)}
    :set ($FHRInstallSources->"dns") $source
}

{
    :global FHRInstallSources
    :local source ":global FHREvaluate do={\n    :global FHRConfig; :global FHRDiscover; :global FHRShortlist\n    :global FHRBenchmark; :global FHRMeasure; :global FHRRank\n    :local svc \$1; :local ranges \$2; :local opts \$3\n    :local rows [\$FHRDiscover \$svc \$ranges (\$opts->\"refresh\") (\$opts->\"cacheOnly\")]\n    :local shortlist [\$FHRShortlist \$svc \$rows (\$opts->\"region\") (\$opts->\"full\")]\n    :local empty {\"ranked\"=[:toarray \"\"];\"bench\"=[:toarray \"\"];\"measured\"=false;\"found\"=[:len \$rows]}\n    :if ([:len \$shortlist] = 0) do={:return \$empty}\n    :put (\"SHORTLIST \" . (\$svc->\"key\") . \": \" . [:len \$shortlist] . \" candidates\")\n    :local bench [\$FHRBenchmark \$svc \$shortlist]\n    :local result [\$FHRMeasure \$svc \$shortlist \$bench]\n    :local eligible [:toarray \"\"]\n    :foreach row in=\$shortlist do={\n        :local sample (\$result->\"samples\"->(\$row->\"ip\"))\n        :if ((\$sample->\"blocked\") != true) do={:set (\$eligible->[:len \$eligible]) \$row}\n    }\n    :local ranked [\$FHRRank \$eligible (\$result->\"samples\")]\n    :foreach row in=\$ranked do={\n        :put (\"RANK \" . (\$svc->\"key\") . \" \" . (\$row->\"ip\") . \" POP=\" . (\$row->\"pop\") . \" smooth=\" . (\$row->\"smooth\") . \"/\" . (\$FHRConfig->\"rounds\") . \" medianApproxKbps=\" . ((\$row->\"medianBps\") / 1000) . \" valid=\" . (\$row->\"valid\") . \" latencyKind=\" . (\$row->\"latencyKind\"))\n    }\n    :if ((\$result->\"measured\") != true) do={:put (\"UNMEASURED \" . (\$svc->\"key\") . \": valid TLS/HTTP routes ranked by available connection timing\")}\n    :return {\"ranked\"=\$ranked;\"bench\"=(\$result->\"bench\");\"measured\"=(\$result->\"measured\");\"found\"=[:len \$rows]}\n}\n:global FHREvaluateX do={\n    :global FHRProbe; :global FHRAllowed\n    :local svc \$1; :local donor \$2; :local region \$3; :local rows [:toarray \"\"]\n    :foreach original in=(\$donor->\"ranked\") do={\n        :local candidate [\$FHRProbe \$svc (\$original->\"ip\") false]\n        :if (((\$candidate->\"ok\") = true) && ((\$candidate->\"pop\") = (\$original->\"pop\")) && [\$FHRAllowed (\$candidate->\"pop\") \$region]) do={\n            :local row \$original\n            :set (\$row->\"ip\") (\$candidate->\"ip\"); :set (\$row->\"donorPOP\") (\$original->\"pop\")\n            :set (\$row->\"borrowed\") true\n            :set (\$rows->[:len \$rows]) \$row\n        }\n    }\n    :put (\"X PROXY: \" . [:len \$rows] . \" .159 candidates with the same observed POP as their GitHub donor\")\n    :return {\"ranked\"=\$rows;\"bench\"=[:toarray \"\"];\"measured\"=(\$donor->\"measured\");\"found\"=[:len \$rows];\"borrowed\"=true}\n}\n:global FHRSelectApply do={\n    :global FHRConfig; :global FHRReadJSON; :global FHRPreflight; :global FHRCommit\n    :local svc \$1; :local evaluated \$2; :local opts \$3\n    :local ranked (\$evaluated->\"ranked\"); :local measured (\$evaluated->\"measured\")\n    :local usable [:toarray \"\"]\n    :foreach row in=\$ranked do={\n        :if (((\$measured = true) && ((\$row->\"valid\") > 0)) || ((\$measured != true) && ((\$FHRConfig->\"allowLatencyFallback\") = true))) do={:set (\$usable->[:len \$usable]) \$row}\n    }\n    :if ([:len \$usable] = 0) do={\n        :put (\"NO CHANGE \" . (\$svc->\"key\") . \": no usable non-Singapore candidate\")\n        :return {\"result\"=\"no-candidate\";\"key\"=(\$svc->\"key\")}\n    }\n    :local current [\$FHRReadJSON (\"current-\" . (\$svc->\"key\"))]\n    :local best (\$usable->0); :local sticky [:toarray \"\"]\n    :if ((\$measured = true) && ((\$FHRConfig->\"stickyPercent\") > 0)) do={\n        :foreach row in=\$usable do={\n            :if (((\$row->\"ip\") = (\$current->\"ip\")) && ((\$row->\"smooth\") = (\$best->\"smooth\")) && ((\$row->\"valid\") >= (\$best->\"valid\")) && ((\$row->\"medianBps\") > 0) && ((\$best->\"medianBps\") * 100 <= (\$row->\"medianBps\") * (100 + (\$FHRConfig->\"stickyPercent\")))) do={:set sticky \$row}\n        }\n    }\n    :if ([:len \$sticky] > 0) do={\n        :local reordered [:toarray \"\"]; :set (\$reordered->0) \$sticky\n        :foreach row in=\$usable do={:if ((\$row->\"ip\") != (\$sticky->\"ip\")) do={:set (\$reordered->[:len \$reordered]) \$row}}\n        :set usable \$reordered\n    }\n    # Fresh group validation and automatic fail-through: no manual candidate gate.\n    :foreach row in=\$usable do={\n        :local proof [\$FHRPreflight \$svc \$row (\$evaluated->\"bench\") (\$opts->\"region\")]\n        :if ((\$proof->\"ok\") = true) do={\n            :set (\$row->\"pop\") (\$proof->\"pop\")\n            :if ((\$opts->\"apply\") = true) do={\n                :local changed [\$FHRCommit \$svc \$row]\n                :return {\"result\"=\"applied-or-kept\";\"key\"=(\$svc->\"key\");\"ip\"=(\$row->\"ip\");\"pop\"=(\$row->\"pop\");\"measured\"=\$measured;\"changed\"=\$changed}\n            }\n            :put (\"TEST SELECT \" . (\$svc->\"key\") . \" \" . (\$row->\"ip\") . \" POP=\" . (\$row->\"pop\"))\n            :return {\"result\"=\"test-only\";\"key\"=(\$svc->\"key\");\"ip\"=(\$row->\"ip\");\"pop\"=(\$row->\"pop\");\"measured\"=\$measured}\n        }\n        :put (\"REJECT ON FINAL CHECK \" . (\$svc->\"key\") . \" \" . (\$row->\"ip\") . \"; trying next ranked candidate\")\n    }\n    :return {\"result\"=\"final-check-failed\";\"key\"=(\$svc->\"key\")}\n}\n:global FHRRunServices do={\n    :global FHRProfiles; :global FHRRanges; :global FHREvaluate; :global FHREvaluateX\n    :global FHRSelectApply; :global FHRDiscover; :global FHRWriteJSON\n    :local opts \$1; :local only [:tostr (\$opts->\"service\")]\n    :if ((\$only != \"\") && ([:typeof (\$FHRProfiles->\$only)] ~ \"^(nil|nothing)\\\$\")) do={:error \"unknown service\"}\n    :local ranges [\$FHRRanges]; :local evaluated [:toarray \"\"]; :local report [:toarray \"\"]\n    :local useX false\n    :if ((((\$FHRProfiles->\"x\"->\"enabled\") = true) && (\$only = \"\")) || (\$only = \"x\")) do={:set useX true}\n    :local order {\"github\";\"twitch\"}\n    :foreach key,svc in=\$FHRProfiles do={:if ((\$key != \"github\") && (\$key != \"x\") && (\$key != \"twitch\")) do={:set (\$order->[:len \$order]) \$key}}\n    :foreach key in=\$order do={\n        :local svc (\$FHRProfiles->\$key)\n        :local requested ((((\$svc->\"enabled\") = true) && (\$only = \"\")) || (\$only = \$key))\n        :local dependency ((\$key = \"github\") && \$useX)\n        :if (\$requested || \$dependency) do={\n            :put (\"=== SERVICE \" . \$key . \" ===\")\n            :onerror e in={\n                :if ((\$opts->\"scanOnly\") = true) do={\n                    :local rows [\$FHRDiscover \$svc \$ranges true false]\n                    :set (\$report->\$key) {\"result\"=\"scanned\";\"count\"=[:len \$rows]}\n                } else={\n                    :local result [\$FHREvaluate \$svc \$ranges \$opts]\n                    :set (\$evaluated->\$key) \$result\n                    :if (\$requested) do={:set (\$report->\$key) [\$FHRSelectApply \$svc \$result \$opts]}\n                }\n            } do={\n                :set (\$report->\$key) {\"result\"=\"error\";\"error\"=[:tostr \$e]}\n                :log error (\"FHR \" . \$key . \": \" . \$e); :put (\"SERVICE FAILED \" . \$key . \": \" . \$e)\n            }\n        }\n    }\n    :if (\$useX && ((\$opts->\"scanOnly\") != true)) do={\n        :onerror e in={\n            :local donor (\$evaluated->\"github\")\n            :if ([:typeof \$donor] != \"array\") do={:error \"GitHub donor ranking unavailable\"}\n            :local result [\$FHREvaluateX (\$FHRProfiles->\"x\") \$donor (\$opts->\"region\")]\n            :set (\$report->\"x\") [\$FHRSelectApply (\$FHRProfiles->\"x\") \$result \$opts]\n        } do={:set (\$report->\"x\") {\"result\"=\"error\";\"error\"=[:tostr \$e]}; :put (\"SERVICE FAILED x: \" . \$e)}\n    }\n    :onerror e in={\$FHRWriteJSON \"last-report\" ({\"at\"=([:tonsec [:timestamp]] / 1000000000);\"results\"=\$report})} do={:log warning (\"FHR report save: \" . \$e)}\n    :put \"=== RESULT ===\"\n    :foreach key,r in=\$report do={:put (\$key . \": \" . (\$r->\"result\") . \" \" . [:tostr (\$r->\"ip\")] . \" \" . [:tostr (\$r->\"pop\")])}\n    :return \$report\n}\n:global FHRHealth do={\n    :global FHRProfiles; :global FHRConfig; :global FHRReadJSON; :global FHRWriteJSON\n    :global FHRPreflight; :global FHRCommit; :global FHRRestore\n    :local failures [\$FHRReadJSON \"health\"]\n    :foreach key,svc in=\$FHRProfiles do={\n        :local current [\$FHRReadJSON (\"current-\" . \$key)]\n        :if (((\$svc->\"enabled\") = true) && ([:tostr (\$current->\"ip\")] != \"\")) do={\n            :local row \$current\n            :if ((\$svc->\"mode\") = \"via\") do={:set (\$row->\"donorPOP\") (\$current->\"pop\")}\n            :local proof [\$FHRPreflight \$svc \$row [:toarray \"\"] (\$FHRConfig->\"region\")]\n            :local count [:tonum (\$failures->\$key)]; :if ([:typeof \$count] = \"nil\") do={:set count 0}\n            :if ((\$proof->\"ok\") = true) do={:set count 0} else={:set count (\$count + 1)}\n            :set (\$failures->\$key) \$count\n            :if (\$count >= (\$FHRConfig->\"healthFailures\")) do={\n                :local old [\$FHRReadJSON (\"previous-\" . \$key)]; :local previous (\$old->\"current\"); :local recovered false\n                :if ([:tostr (\$previous->\"ip\")] != \"\") do={\n                    :if ((\$svc->\"mode\") = \"via\") do={:set (\$previous->\"donorPOP\") (\$previous->\"pop\")}\n                    :local test [\$FHRPreflight \$svc \$previous [:toarray \"\"] (\$FHRConfig->\"region\")]\n                    :if ((\$test->\"ok\") = true) do={\n                        :set (\$previous->\"pop\") (\$test->\"pop\")\n                        :local changed [\$FHRCommit \$svc \$previous]\n                        :set recovered true; :put (\"HEALTH ROLLBACK \" . \$key)\n                    }\n                }\n                :if ((!\$recovered) && ((\$FHRConfig->\"healthFailOpen\") = true)) do={\n                    \$FHRRestore \$key\n                    :put (\"HEALTH FALLBACK \" . \$key . \": automatic DNS override removed; upstream DNS may return Singapore\")\n                }\n                :set (\$failures->\$key) 0\n            }\n        }\n    }\n    \$FHRWriteJSON \"health\" \$failures\n}\n"
    :onerror err in={:local compiled [:parse $source]} do={:error ("Compile check failed: FHR.engine: " . $err)}
    :set ($FHRInstallSources->"engine") $source
}

{
    :global FHRInstallSources
    :local source ":global FHRValidateConfig do={\n    :global FHRConfig; :global FHRHostValid; :global FHRIPNum\n    :local bounds {\"parallel\"={1;32};\"rounds\"={1;9};\"shortlist\"={1;64};\"sampleBytes\"={262144;33554432};\"sampleSeconds\"={3;120};\"probeSeconds\"={2;30};\"smoothFloorBps\"={1;1000000000};\"smoothPercent\"={1;100};\"stickyPercent\"={0;100};\"cacheSeconds\"={60;604800};\"cacheStaleSeconds\"={60;2592000};\"maxTextBytes\"={65536;4194304};\"maxBlocks\"={256;65536};\"healthFailures\"={1;20};\"nearMarginMs\"={0;1000}}\n    :foreach k,limits in=\$bounds do={\n        :local value [:tonum (\$FHRConfig->\$k)]\n        :if ([:typeof \$value] = \"nil\") do={:error (\"configuration \" . \$k . \" must be an integer\")}\n        :if ((\$value < (\$limits->0)) || (\$value > (\$limits->1))) do={:error (\"configuration out of range: \" . \$k)}\n        :set (\$FHRConfig->\$k) \$value\n    }\n    :foreach k in={\"adoptLegacy\";\"allowLatencyFallback\";\"healthFailOpen\";\"verbose\"} do={:if ([:typeof (\$FHRConfig->\$k)] != \"bool\") do={:error (\"configuration \" . \$k . \" must be true or false\")}}\n    :local src [\$FHRIPNum (\$FHRConfig->\"sourceAddress\")]\n    :local ttl [:totime (\$FHRConfig->\"dnsTTL\")]\n    :if ((\$ttl < 1m) || (\$ttl > 1d)) do={:error \"dnsTTL must be between 1m and 1d\"}\n    :local re [:tostr (\$FHRConfig->\"excluded\")]\n    :if (!(\$re ~ \"^[|]([A-Z]{3}[|])*\\\$\")) do={:error \"excluded must be a pipe-delimited set, e.g. |SIN|QPG|\"}\n    :if (((\$FHRConfig->\"latencyProbe\") != \"tcp\") && ((\$FHRConfig->\"latencyProbe\") != \"head\")) do={:error \"latencyProbe must be tcp or head\"}\n}\n:global FHRAddCustom do={\n    :global FHRProfiles; :global FHRTrim; :global FHRHostValid; :global FHRURL\n    :global FHRRanges; :global FHRResolveAll; :global FHRInRanges; :global FHRIPNum\n    :global FHRHTTP; :global FHRSaveSettings\n    :local host [:convert transform=lc [\$FHRTrim \$1]]; :local testURL [:tostr \$2]\n    :if ([:pick \$host 0 8] = \"https://\") do={:local u [\$FHRURL \$host]; :set host (\$u->\"host\")}\n    :if (![\$FHRHostValid \$host]) do={:error \"invalid custom DNS hostname\"}\n    :foreach key,svc in=\$FHRProfiles do={:if (!([:typeof (\$svc->\"hosts\"->\$host)] ~ \"^(nil|nothing)\\\$\")) do={:error \"hostname is already in a profile\"}}\n    :local ranges [\$FHRRanges]; :local counts [:toarray \"\"]; :local bestCount 0; :local suffix -1; :local original \"\"\n    :foreach ip in=[\$FHRResolveAll \$host] do={\n        :if ([\$FHRInRanges \$ip \$ranges]) do={\n            :local s [:tostr ([\$FHRIPNum \$ip] % 256)]; :local count [:tonum (\$counts->\$s)]\n            :if ([:typeof \$count] = \"nil\") do={:set count 0}\n            :set count (\$count + 1); :set (\$counts->\$s) \$count\n            :if (\$count > \$bestCount) do={:set bestCount \$count; :set suffix [:tonum \$s]; :set original \$ip}\n        }\n    }\n    :if (\$suffix < 0) do={:error \"current A answers are outside Fastly's public IPv4 ranges\"}\n    :local r [\$FHRHTTP ({\"url\"=(\"https://\" . \$host . \"/\");\"ip\"=\$original;\"method\"=\"head\"})]\n    :if (((\$r->\"code\") < 200) || ((\$r->\"code\") >= 500)) do={:error \"custom hostname failed TLS/HTTP validation\"}\n    :if (\$testURL != \"\") do={\n        :local parsed [\$FHRURL \$testURL]\n        :if ((\$parsed->\"host\") != \$host) do={:error \"test URL must use the same hostname as the custom domain\"}\n    }\n    :local key (\"custom.\" . \$host); :local hosts [:toarray \"\"]; :local paths [:toarray \"\"]\n    :set (\$hosts->\$host) \$suffix; :set (\$paths->\$host) \"/\"\n    :set (\$FHRProfiles->\$key) {\"key\"=\$key;\"enabled\"=true;\"mode\"=\"custom\";\"probeHost\"=\$host;\"probePath\"=\"/\";\"suffix\"=\$suffix;\"anyStatus\"=true;\"popHost\"=\"\";\"testURL\"=\$testURL;\"hosts\"=\$hosts;\"paths\"=\$paths}\n    \$FHRSaveSettings\n    :put (\"ADDED \" . \$key . \" suffix=.\" . \$suffix . \" measured=\" . (\$testURL != \"\"))\n}\n:global FHRList do={\n    :global FHRProfiles; :global FHRCacheRead\n    :local only [:tostr \$1]; :local grouped [:toarray \"\"]\n    :foreach key,svc in=\$FHRProfiles do={\n        :if ((\$only = \"\") || (\$only = \$key)) do={\n            :if ((\$svc->\"mode\") = \"via\") do={:put (\$key . \": borrows \" . (\$svc->\"via\") . \" ranking after its own TLS/POP verification\")} else={\n                :local cache [\$FHRCacheRead \$key]\n                :foreach row in=(\$cache->\"rows\") do={\n                    :local pop (\$row->\"pop\"); :local group (\$grouped->\$pop)\n                    :if ([:typeof \$group] != \"array\") do={:set group {\"pop\"=\$pop;\"counts\"=[:toarray \"\"];\"us\"=9223372036854775807;\"kind\"=\"head\"}}\n                    :local count [:tonum (\$group->\"counts\"->\$key)]; :if ([:typeof \$count] = \"nil\") do={:set count 0}\n                    :set (\$group->\"counts\"->\$key) (\$count + 1)\n                    :if ((\$row->\"latencyUs\") < (\$group->\"us\")) do={:set (\$group->\"us\") (\$row->\"latencyUs\"); :set (\$group->\"kind\") (\$row->\"latencyKind\")}\n                    :set (\$grouped->\$pop) \$group\n                }\n            }\n        }\n    }\n    :local ordered [:toarray \"\"]\n    :foreach pop,group in=\$grouped do={\n        :local next [:toarray \"\"]; :local added false\n        :foreach old in=\$ordered do={\n            :if ((!\$added) && ((\$group->\"us\") < (\$old->\"us\"))) do={:set (\$next->[:len \$next]) \$group; :set added true}\n            :set (\$next->[:len \$next]) \$old\n        }\n        :if (!\$added) do={:set (\$next->[:len \$next]) \$group}\n        :set ordered \$next\n    }\n    :foreach group in=\$ordered do={\n        :local line (\"POP \" . (\$group->\"pop\") . \" timingUs=\" . (\$group->\"us\") . \" timingKind=\" . (\$group->\"kind\"))\n        :foreach key,count in=(\$group->\"counts\") do={:set line (\$line . \" \" . \$key . \"=\" . \$count)}\n        :put \$line\n    }\n}\n:global FHRStatus do={\n    :global FHRConfig; :global FHRProfiles; :global FHRReadJSON\n    :put (\"FHR \" . (\$FHRConfig->\"version\") . \" excluded=\" . (\$FHRConfig->\"excluded\") . \" default-region=\" . (\$FHRConfig->\"region\"))\n    :foreach key,svc in=\$FHRProfiles do={\n        :local current [\$FHRReadJSON (\"current-\" . \$key)]\n        :put (\$key . \" enabled=\" . (\$svc->\"enabled\") . \" selected=\" . [:tostr (\$current->\"ip\")] . \" last-verified-POP=\" . [:tostr (\$current->\"pop\")])\n    }\n    /ip dns static print detail where comment~\"^FHR:auto:\"\n    /system scheduler print where name~\"^FHR[.]\"\n}\n:global FHRSchedule do={\n    :local fhrScheduleEnabled \$1\n    :foreach fhrScheduleName in={\"FHR.auto\";\"FHR.health\";\"FHR.boot\"} do={\n        :local fhrScheduleIds [/system scheduler find where name=\$fhrScheduleName]\n        :if ([:len \$fhrScheduleIds] > 1) do={:error (\"duplicate exact scheduler name: \" . \$fhrScheduleName)}\n        :foreach fhrScheduleId in=\$fhrScheduleIds do={\n            :if ([/system scheduler get \$fhrScheduleId name] != \$fhrScheduleName) do={:error \"scheduler lookup returned a different name\"}\n            :if ([/system scheduler get \$fhrScheduleId comment] != \"FHR native v1\") do={:error (\"unmanaged scheduler uses \" . \$fhrScheduleName)}\n        }\n    }\n    :if (\$fhrScheduleEnabled = true) do={\n        # Verify file access with declared runtime permissions, not the interactive user.\n        /system script run FHR.selftest use-script-permissions\n        :if ([:len [/system scheduler find where name=\"FHR.auto\"]] = 0) do={/system scheduler add name=\"FHR.auto\" interval=6h start-time=00:00:00 disabled=yes policy=ftp,read,write,policy,test,sensitive on-event=\"/system script run FHR.apply\" comment=\"FHR native v1\"}\n        :if ([:len [/system scheduler find where name=\"FHR.health\"]] = 0) do={/system scheduler add name=\"FHR.health\" interval=15m start-time=00:02:00 disabled=yes policy=ftp,read,write,policy,test,sensitive on-event=\"/system script run FHR.health\" comment=\"FHR native v1\"}\n        :if ([:len [/system scheduler find where name=\"FHR.boot\"]] = 0) do={/system scheduler add name=\"FHR.boot\" interval=0s start-time=startup disabled=yes policy=ftp,read,write,policy,test,sensitive on-event=\":delay 30s; /system script run FHR.health\" comment=\"FHR native v1\"}\n        :foreach fhrScheduleName in={\"FHR.auto\";\"FHR.health\";\"FHR.boot\"} do={\n            :foreach fhrScheduleId in=[/system scheduler find where name=\$fhrScheduleName] do={\n                :if (([/system scheduler get \$fhrScheduleId name] != \$fhrScheduleName) || ([/system scheduler get \$fhrScheduleId comment] != \"FHR native v1\")) do={:error \"scheduler ownership changed\"}\n                /system scheduler set \$fhrScheduleId policy=ftp,read,write,policy,test,sensitive\n                /system scheduler enable \$fhrScheduleId\n            }\n        }\n        :put \"SCHEDULE ENABLED: apply every 6h, health every 15m, boot health check\"\n    } else={\n        :foreach fhrScheduleName in={\"FHR.auto\";\"FHR.health\";\"FHR.boot\"} do={\n            :foreach fhrScheduleId in=[/system scheduler find where name=\$fhrScheduleName] do={\n                :if (([/system scheduler get \$fhrScheduleId name] != \$fhrScheduleName) || ([/system scheduler get \$fhrScheduleId comment] != \"FHR native v1\")) do={:error \"scheduler ownership changed\"}\n                /system scheduler disable \$fhrScheduleId\n            }\n        }\n        :put \"SCHEDULE DISABLED\"\n    }\n}\n:global FHRDispatch do={\n    :global FHRConfig; :global FHRProfiles; :global FHRRunServices; :global FHRRegionCode\n    :global FHRStatus; :global FHRList; :global FHRHealth; :global FHRRestore; :global FHRSchedule\n    :global FHRAddCustom; :global FHRSaveSettings; :global FHRReadJSON; :global FHRDeleteState\n    :global FHRPreflight; :global FHRCommit; :global FHRValidateConfig; :global FHRText\n    :local request \$1; :local action [:tostr (\$request->\"action\")]; :local service [:tostr (\$request->\"service\")]\n    :if ((\$action = \"apply\") || (\$action = \"test\") || (\$action = \"scan\") || (\$action = \"region\") || (\$action = \"switch\")) do={\n        :local region [:tostr (\$request->\"region\")]\n        :if (\$region = \"\") do={:set region (\$FHRConfig->\"region\")}\n        :set region [\$FHRRegionCode \$region]\n        :if ((\$region != \"\") && ([:typeof [:find (\$FHRConfig->\"excluded\") (\"|\" . \$region . \"|\")]] != \"nil\")) do={:error \"requested POP is explicitly excluded\"}\n        :if (((\$action = \"region\") || (\$action = \"switch\")) && (\$region = \"\")) do={:error \"region/switch requires a POP code\"}\n        :local opts {\"service\"=\$service;\"region\"=\$region;\"apply\"=((\$action != \"test\") && (\$action != \"scan\"));\"scanOnly\"=(\$action = \"scan\");\"refresh\"=((\$action = \"scan\") || (\$action = \"region\") || ((\$request->\"refresh\") = true));\"cacheOnly\"=(\$action = \"switch\");\"full\"=((\$request->\"full\") = true)}\n        :return [\$FHRRunServices \$opts]\n    }\n    :if (\$action = \"status\") do={\$FHRStatus; :return true}\n    :if (\$action = \"list\") do={\$FHRList \$service; :return true}\n    :if (\$action = \"health\") do={\$FHRHealth; :return true}\n    :if (\$action = \"enable-schedule\") do={\$FHRSchedule true; :return true}\n    :if (\$action = \"disable-schedule\") do={\$FHRSchedule false; :return true}\n    :if (\$action = \"restore\") do={\$FHRSchedule false; \$FHRRestore \$service; :return true}\n    :if (\$action = \"add\") do={\$FHRAddCustom (\$request->\"domain\") (\$request->\"url\"); :return true}\n    :if ((\$action = \"enable\") || (\$action = \"disable\") || (\$action = \"remove\")) do={\n        :if ([:typeof (\$FHRProfiles->\$service)] ~ \"^(nil|nothing)\\\$\") do={:error \"unknown service\"}\n        :if (\$action = \"remove\") do={\n            :if ([:pick \$service 0 7] != \"custom.\") do={:error \"built-in profiles can be disabled, not removed\"}\n            \$FHRRestore \$service\n            :local keep [:toarray \"\"]; :foreach k,v in=\$FHRProfiles do={:if (\$k != \$service) do={:set (\$keep->\$k) \$v}}\n            :set FHRProfiles \$keep\n        } else={\n            :set (\$FHRProfiles->\$service->\"enabled\") (\$action = \"enable\")\n            :if (\$action = \"disable\") do={\$FHRRestore \$service}\n        }\n        \$FHRSaveSettings; :return true\n    }\n    :if (\$action = \"set-test-url\") do={\n        :global FHRURL\n        :if ([:typeof (\$FHRProfiles->\$service)] ~ \"^(nil|nothing)\\\$\") do={:error \"unknown service\"}\n        :local u [:tostr (\$request->\"url\")]\n        :if (\$u != \"\") do={\n            :local p [\$FHRURL \$u]\n            :local expected (\$FHRProfiles->\$service->\"probeHost\")\n            :if (\$service = \"twitch\") do={:set expected \"assets.twitch.tv\"}\n            :if ((\$p->\"host\") != \$expected) do={:error \"test URL hostname does not match profile\"}\n        }\n        :if ((\$service = \"github\") || (\$service = \"x\")) do={:error \"GitHub/X use the release adapter; configure releaseRepos instead\"}\n        :set (\$FHRProfiles->\$service->\"testURL\") \$u; \$FHRSaveSettings; :return true\n    }\n    :if (\$action = \"set\") do={\n        :local property [:tostr (\$request->\"property\")]\n        :if (([:typeof (\$FHRConfig->\$property)] ~ \"^(nil|nothing)\\\$\") || (\$property = \"version\") || (\$property = \"fallbackCIDRs\")) do={:error \"unknown or read-only property\"}\n        :local old \$FHRConfig\n        :set (\$FHRConfig->\$property) (\$request->\"value\")\n        :onerror e in={\$FHRValidateConfig; \$FHRSaveSettings} do={:set FHRConfig \$old; :error \$e}\n        :return true\n    }\n    :if (\$action = \"rollback\") do={\n        :if ([:typeof (\$FHRProfiles->\$service)] ~ \"^(nil|nothing)\\\$\") do={:error \"rollback requires service=github, x, twitch or a custom key\"}\n        :local prev [\$FHRReadJSON (\"previous-\" . \$service)]\n        :local row (\$prev->\"current\")\n        :if ([:tostr (\$row->\"ip\")] = \"\") do={\$FHRRestore \$service; :return true}\n        :if (\$service = \"x\") do={:set (\$row->\"donorPOP\") (\$row->\"pop\")}\n        :local p [\$FHRPreflight (\$FHRProfiles->\$service) \$row [:toarray \"\"] (\$FHRConfig->\"region\")]\n        :if ((\$p->\"ok\") != true) do={:error \"previous route is not valid under current POP policy; use restore for upstream DNS\"}\n        :set (\$row->\"pop\") (\$p->\"pop\"); :local changed [\$FHRCommit (\$FHRProfiles->\$service) \$row]; :return true\n    }\n    :if (\$action = \"purge\") do={\n        :global FHRDir\n        \$FHRSchedule false\n        \$FHRRestore \"\"\n        :foreach f in=[/file print as-value] do={\n            :local fhrStateFileName [:tostr (\$f->\"name\")]\n            :if (([:pick \$fhrStateFileName 0 ([:len \$FHRDir] + 1)] = (\$FHRDir . \"/\")) && (\$fhrStateFileName != (\$FHRDir . \"/run.lock\")) && ((\$f->\"type\") != \"directory\")) do={/file remove (\$f->\".id\")}\n        }\n        /system script run FHR.config\n        :put \"PURGED state and restored managed DNS; native program remains installed\"\n        :return true\n    }\n    :if (\$action = \"set-probe-path\") do={\n        :if ([:typeof (\$FHRProfiles->\$service)] ~ \"^(nil|nothing)\\\$\") do={:error \"unknown service\"}\n        :local path [:tostr (\$request->\"value\")]\n        :if (([:pick \$path 0 1] != \"/\") || (\$path ~ \"[\\r\\n]\")) do={:error \"probe path must be an absolute path without control characters\"}\n        :set (\$FHRProfiles->\$service->\"probePath\") \$path\n        :set (\$FHRProfiles->\$service->\"paths\"->(\$FHRProfiles->\$service->\"probeHost\")) \$path\n        \$FHRSaveSettings\n        :return true\n    }\n    :if (\$action = \"check-update\") do={\n        :local data [:deserialize from=json options=json.no-string-conversion value=[\$FHRText ({\"url\"=\"https://api.github.com/repos/AFAlimru/fastly-hosts-adjust/releases/latest\";\"headers\"=\"Accept:application/vnd.github+json\"})]]\n        :put (\"Upstream Python release: \" . (\$data->\"tag_name\") . \"; port reference: v0.8.3; local port: \" . (\$FHRConfig->\"version\"))\n        :put \"No code downloaded or executed. Upgrade the native port by importing a reviewed replacement bundle.\"\n        :return true\n    }\n    :error (\"unknown action: \" . \$action . \"; run /system script run FHR.help\")\n}\n:global FHR do={\n    # Public API. A per-filesystem lock serializes different RouterOS users too.\n    :global FHRDir; :global FHRDispatch; :global FHRRecover; :global FHRValidateConfig\n    :local request {\"action\"=\$action;\"service\"=\$service;\"region\"=\$region;\"domain\"=\$domain;\"url\"=\$url;\"property\"=\$property;\"value\"=\$value;\"refresh\"=\$refresh;\"full\"=\$full}\n    :local lock (\$FHRDir . \"/run.lock\"); :local token [:tostr [:tonsec [:timestamp]]]\n    :if ([:len [/file find where name=\$lock]] > 0) do={\n        :local stale false\n        :onerror e in={\n            :local old [:deserialize from=json options=json.no-string-conversion value=[/file get [/file find where name=\$lock] contents]]\n            :local now ([:tonsec [:timestamp]] / 1000000000)\n            :local uptime ([:tonsec [/system resource get uptime]] / 1000000000)\n            :local boot (\$now - \$uptime); :local delta (\$boot - (\$old->\"boot\"))\n            :if ((\$delta > 300) || (\$delta < -300) || ((\$now - (\$old->\"at\")) > 14400)) do={:set stale true}\n        } do={:error \"unreadable FHR lock; inspect fhr-state/run.lock before removing it\"}\n        :if (\$stale) do={/file remove [/file find where name=\$lock]} else={:put \"FHR BUSY: another run owns the lock; no changes made\"; :return false}\n    }\n    :local now ([:tonsec [:timestamp]] / 1000000000)\n    :local boot (\$now - ([:tonsec [/system resource get uptime]] / 1000000000))\n    :local lockData [:serialize to=json options=json.no-string-conversion value={\"token\"=\$token;\"at\"=\$now;\"boot\"=\$boot}]\n    /file add name=\$lock type=file contents=\$lockData\n    :local result [:toarray \"\"]; :local failed \"\"\n    :onerror e in={\n        \$FHRValidateConfig\n        \$FHRRecover\n        :set result [\$FHRDispatch \$request]\n    } do={:set failed [:tostr \$e]}\n    :onerror e in={\n        :local current [:deserialize from=json options=json.no-string-conversion value=[/file get [/file find where name=\$lock] contents]]\n        :if ((\$current->\"token\") = \$token) do={/file remove [/file find where name=\$lock]}\n    } do={}\n    :if (\$failed != \"\") do={:log error (\"FHR: \" . \$failed); :error \$failed}\n    :return \$result\n}\n"
    :onerror err in={:local compiled [:parse $source]} do={:error ("Compile check failed: FHR.commands: " . $err)}
    :set ($FHRInstallSources->"commands") $source
}

{
    :global FHRInstallSources
    :local source ":onerror fhrModuleError in={/system script run FHR.config} do={:error (\"FHR.load/config: \" . \$fhrModuleError)}\n:onerror fhrModuleError in={/system script run FHR.core} do={:error (\"FHR.load/core: \" . \$fhrModuleError)}\n:onerror fhrModuleError in={/system script run FHR.storage} do={:error (\"FHR.load/storage: \" . \$fhrModuleError)}\n:onerror fhrModuleError in={/system script run FHR.network} do={:error (\"FHR.load/network: \" . \$fhrModuleError)}\n:onerror fhrModuleError in={/system script run FHR.benchmarks} do={:error (\"FHR.load/benchmarks: \" . \$fhrModuleError)}\n:onerror fhrModuleError in={/system script run FHR.discovery} do={:error (\"FHR.load/discovery: \" . \$fhrModuleError)}\n:onerror fhrModuleError in={/system script run FHR.dns} do={:error (\"FHR.load/dns: \" . \$fhrModuleError)}\n:onerror fhrModuleError in={/system script run FHR.engine} do={:error (\"FHR.load/engine: \" . \$fhrModuleError)}\n:onerror fhrModuleError in={/system script run FHR.commands} do={:error (\"FHR.load/commands: \" . \$fhrModuleError)}\n:global FHRLoadSettings; :onerror e in={\$FHRLoadSettings} do={:error (\"FHR.load/settings: \" . \$e)}\n:global FHRValidateConfig; :onerror e in={\$FHRValidateConfig} do={:error (\"FHR.load/validation: \" . \$e)}\n"
    :onerror err in={:local compiled [:parse $source]} do={:error ("Compile check failed: FHR.load: " . $err)}
    :set ($FHRInstallSources->"load") $source
}

{
    :global FHRInstallSources
    :local source "/system script run FHR.load\n# Local deterministic checks. No HTTP, DNS changes, routes, NAT or mangle writes.\n# Includes a small state-file roundtrip. Installed modules must already be loaded.\n:global FHRTrim; :global FHRSplit; :global FHRHeader; :global FHRPop\n:global FHRIPNum; :global FHRNumIP; :global FHRSame24; :global FHRCIDR; :global FHRInRanges; :global FHRBlocks\n:global FHRAllowed; :global FHRHostValid; :global FHRURL; :global FHRMedian; :global FHRRank; :global FHRRange\n:global FHRConfig; :global FHRProfiles; :global FHRReadJSON; :global FHRWriteJSON; :global FHRDeleteState; :global FHRDir\n:global FHRTestCount 0\n:global FHRAssert do={\n    :global FHRTestCount\n    :if (\$1 != true) do={:error (\"SELFTEST FAILED: \" . \$2)}\n    :set FHRTestCount (\$FHRTestCount + 1)\n}\n:local originalConfig [:deserialize from=json options=json.no-string-conversion value=[:serialize to=json options=json.no-string-conversion value=\$FHRConfig]]\n:local failed \"\"\n:onerror e in={\n    # The lookup variable must be distinct from the RouterOS name property.\n    :local fhrExpectedScriptName \"FHR.config\"\n    :local fhrLookupIds [/system script find where name=\$fhrExpectedScriptName]\n    \$FHRAssert ([:len \$fhrLookupIds] = 1) \"exact script lookup count\"\n    \$FHRAssert ([/system script get (\$fhrLookupIds->0) name] = \$fhrExpectedScriptName) \"exact script lookup identity\"\n    :local fhrAbsentScriptName (\"FHR.selftest.absent.\" . [:tostr [:tonsec [:timestamp]]])\n    \$FHRAssert ([:len [/system script find where name=\$fhrAbsentScriptName]] = 0) \"missing script lookup stays empty\"\n    \$FHRAssert ([:len [/system scheduler find where name=\$fhrAbsentScriptName]] = 0) \"missing scheduler lookup stays empty\"\n    :set (\$FHRConfig->\"excluded\") \"|SIN|QPG|\"\n    :set (\$FHRConfig->\"smoothFloorBps\") 3000000\n    :set (\$FHRConfig->\"smoothPercent\") 30\n    \$FHRAssert ([\$FHRTrim (\" \\tvalue\\r\\n\")] = \"value\") \"trim\"\n    \$FHRAssert ([:len [\$FHRSplit \"a,b,c\" \",\"]] = 3) \"split\"\n    :local h {\"Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'\";\"x-SeRvEd-By: cache-nrt-test-NRT\"}\n    \$FHRAssert ([\$FHRHeader \$h \"X-Served-By\"] = \"cache-nrt-test-NRT\") \"header array\"\n    \$FHRAssert ([\$FHRHeader ({\"x-served-by\"=\"cache-itm-test-ITM\"}) \"X-Served-By\"] = \"cache-itm-test-ITM\") \"header map\"\n    \$FHRAssert ([\$FHRHeader ({\"Location: https://example.com/a;b?x=1&y=2\"}) \"location\"] = \"https://example.com/a;b?x=1&y=2\") \"header value semicolon\"\n    \$FHRAssert ([\$FHRPop \"cache-nrt-rjtf7700089-NRT\"] = \"NRT\") \"simple POP\"\n    \$FHRAssert ([\$FHRPop \"t4_p, cache-nrt-rjaa8190044-NRT, cache-sin-wsat1880090-SIN, cache-tw-ZZZ1\"] = \"SIN\") \"last valid cache POP\"\n    \$FHRAssert ([\$FHRPop \"cache-tw-ZZZ1\"] = \"?\") \"invalid suffix rejected\"\n    \$FHRAssert ([\$FHRPop \"\"] = \"?\") \"empty POP\"\n    \$FHRAssert ([\$FHRIPNum \"255.255.255.255\"] = 4294967295) \"IPv4 maximum\"\n    \$FHRAssert ([\$FHRNumIP 4294967295] = \"255.255.255.255\") \"IPv4 inverse\"\n    \$FHRAssert ([\$FHRSame24 \"146.75.48.133\" 159] = \"146.75.48.159\") \"suffix substitution\"\n    :local c [\$FHRCIDR \"151.101.129.3/16\"]\n    \$FHRAssert ([\$FHRNumIP (\$c->\"base\")] = \"151.101.0.0\") \"CIDR normalization\"\n    :local b [\$FHRBlocks ({\"10.0.0.0/23\";\"10.0.1.0/24\"}) 100]\n    \$FHRAssert ([:len \$b] = 2) \"all /24 blocks, deduplicated\"\n    \$FHRAssert ([\$FHRInRanges \"151.101.192.133\" ({\"151.101.0.0/16\"})]) \"membership\"\n    \$FHRAssert (![\$FHRInRanges \"8.8.8.8\" ({\"151.101.0.0/16\"})]) \"foreign IPv4\"\n    \$FHRAssert (![\$FHRAllowed \"SIN\" \"\"]) \"SIN excluded\"\n    \$FHRAssert (![\$FHRAllowed \"QPG\" \"\"]) \"QPG excluded\"\n    \$FHRAssert ([\$FHRAllowed \"NRT\" \"NRT\"]) \"requested region\"\n    \$FHRAssert (![\$FHRAllowed \"ITM\" \"NRT\"]) \"different region\"\n    \$FHRAssert (![\$FHRAllowed \"?\" \"\"]) \"unknown region\"\n    \$FHRAssert ([\$FHRHostValid \"files.pythonhosted.org\"]) \"custom hostname\"\n    \$FHRAssert (![\$FHRHostValid (\"x\\r\\n.example.com\")]) \"host control characters\"\n    \$FHRAssert (![\$FHRHostValid \"127.0.0.1\"]) \"IP literal not hostname\"\n    :local u [\$FHRURL \"https://example.com/a?x=1&y=2\"]\n    \$FHRAssert ((\$u->\"host\") = \"example.com\") \"URL hostname\"\n    \$FHRAssert ((\$u->\"path\") = \"/a?x=1&y=2\") \"URL query preservation\"\n    :local rejected false\n    :onerror err in={:local x [\$FHRURL \"http://example.com/\"]} do={:set rejected true}\n    \$FHRAssert \$rejected \"HTTP downgrade rejected\"\n    \$FHRAssert ([\$FHRMedian ({10;1;5})] = 5) \"median odd\"\n    \$FHRAssert ([\$FHRMedian ({10;1})] = 5) \"median integer even\"\n    :local rows [:toarray \"\"]\n    :set (\$rows->0) {\"ip\"=\"1.1.1.133\";\"latencyUs\"=9000}\n    :set (\$rows->1) {\"ip\"=\"2.2.2.133\";\"latencyUs\"=1000}\n    \$FHRAssert (([:len \$rows] = 2) && ((\$rows->0->\"ip\") = \"1.1.1.133\")) \"array of dictionaries not flattened\"\n    :local samples [:toarray \"\"]\n    :set (\$samples->\"1.1.1.133\") {\"rates\"={10000000;10000000;10000000};\"valid\"=3}\n    :set (\$samples->\"2.2.2.133\") {\"rates\"={20000000;1000000;20000000};\"valid\"=3}\n    :local ranked [\$FHRRank \$rows \$samples]\n    \$FHRAssert ((\$ranked->0->\"ip\") = \"1.1.1.133\") \"smooth count before peak/median\"\n    \$FHRAssert ((\$ranked->0->\"smooth\") = 3) \"smooth count threshold\"\n    :local noSpeed [\$FHRRank \$rows [:toarray \"\"]]\n    \$FHRAssert ((\$noSpeed->0->\"ip\") = \"2.2.2.133\") \"latency fallback\"\n    :local range [\$FHRRange \"bytes 0-1023/8388608\"]\n    \$FHRAssert (((\$range->\"first\") = 0) && ((\$range->\"total\") = 8388608)) \"Content-Range\"\n    \$FHRAssert ([:len [\$FHRRange \"bytes 0-1023/*\"]] = 0) \"unknown size rejected\"\n    \$FHRAssert ([:len (\$FHRProfiles->\"github\"->\"hosts\")] = 2) \"GitHub alias count\"\n    \$FHRAssert ([:len (\$FHRProfiles->\"twitch\"->\"hosts\")] = 5) \"Twitch alias count\"\n    \$FHRAssert ((\$FHRProfiles->\"x\"->\"suffix\") = 159) \"X suffix\"\n    \$FHRAssert ((\$FHRProfiles->\"twitch\"->\"hosts\"->\"k.twitchcdn.net\") = 167) \"Twitch secondary suffix\"\n    \$FHRWriteJSON \"selftest\" ({\"test\"=true;\"ip\"=\"151.101.192.133\";\"rows\"=\$rows})\n    :local saved [\$FHRReadJSON \"selftest\"]\n    \$FHRAssert (((\$saved->\"test\") = true) && ((\$saved->\"rows\"->1->\"ip\") = \"2.2.2.133\")) \"state-file roundtrip\"\n    :local path (\$FHRDir . \"/selftest.json\")\n    :local chunk [/file read file=\$path offset=0 chunk-size=4 as-value]\n    \$FHRAssert ([:len [:tostr (\$chunk->\"data\")]] = 4) \"native chunked file read\"\n    # Replace an existing state file and read the previous generation.\n    \$FHRWriteJSON \"selftest\" ({\"test\"=true;\"ip\"=\"151.101.192.133\";\"generation\"=2})\n    :local revised [\$FHRReadJSON \"selftest\"]\n    \$FHRAssert ((\$revised->\"generation\") = 2) \"existing state replaced with declared permissions\"\n    :local priorPath (\$path . \".prev\")\n    :local prior [:deserialize from=json options=json.no-string-conversion value=[/file get [/file find where name=\$priorPath] contents]]\n    \$FHRAssert ((\$prior->\"rows\"->1->\"ip\") = \"2.2.2.133\") \"renamed prior state remains readable\"\n    \$FHRDeleteState \"selftest\"\n} do={:set failed [:tostr \$e]}\n:set FHRConfig \$originalConfig\n:onerror e in={\$FHRDeleteState \"selftest\"} do={}\n:if (\$failed != \"\") do={:error \$failed}\n:put (\"SELFTEST PASS: \" . \$FHRTestCount . \" native local checks; no Internet/DNS/routing changes\")\n"
    :onerror err in={:local compiled [:parse $source]} do={:error ("Compile check failed: FHR.selftest: " . $err)}
    :set ($FHRInstallSources->"selftest") $source
}

