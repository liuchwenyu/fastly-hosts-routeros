{
    :global FHRInstallSources
    :local source "\n:put \"Fastly Hosts RouterOS 1.0.0 (reference: upstream Python 0.8.3)\"\n:put \"Quick commands: /system script run FHR.apply | FHR.status | FHR.restore\"\n:put \"Load API in a new terminal: /system script run FHR.load; :global FHR\"\n:put \"\\\$FHR action=apply [service=github|x|twitch|custom.DOMAIN] [refresh=true]\"\n:put \"\\\$FHR action=test   -- selects but does not change DNS\"\n:put \"\\\$FHR action=scan   -- full discovery, updates scan cache, not DNS\"\n:put \"\\\$FHR action=region region=NRT -- fresh discovery, select and apply this POP\"\n:put \"\\\$FHR action=switch region=NRT -- revalidate cached routes, select and apply\"\n:put \"\\\$FHR action=list [service=github] -- cached POP inventory\"\n:put \"\\\$FHR action=add domain=video.twimg.com [url=https://video.twimg.com/PATH]\"\n:put \"\\\$FHR action=set-test-url service=custom.video.twimg.com url=https://video.twimg.com/PATH\"\n:put \"\\\$FHR action=set-probe-path service=x value=/profile_images/KNOWN_IMAGE.jpg\"\n:put \"\\\$FHR action=enable|disable|remove service=KEY\"\n:put \"\\\$FHR action=set property=parallel value=8 -- typed configuration values\"\n:put \"\\\$FHR action=rollback service=github -- revalidate previous route first\"\n:put \"\\\$FHR action=restore -- stop schedules and restore pre-install managed names\"\n:put \"\\\$FHR action=purge -- restore DNS and remove state; native scripts remain\"\n:put \"\\\$FHR action=enable-schedule|disable-schedule|health|status|check-update\"\n:put \"All exact A-record changes are owned by comment prefix FHR:auto:.\"\n:put \"Default excludes SIN/QPG. No eligible candidate: keep existing DNS.\"\n:put \"Health fail-open may restore an upstream answer in Singapore; it is not a geo firewall.\"\n"
    :onerror err in={:local compiled [:parse $source]} do={:error ("Compile check failed: FHR.help: " . $err)}
    :set ($FHRInstallSources->"help") $source
}

{
    :global FHRInstallSources
    :local source "\n/system resource print\n/ip dns print\n/ip dhcp-server network print detail\n/ip firewall mangle print detail where chain=output\n/ip route print detail where dst-address=\"0.0.0.0/0\"\n/ip dns static print detail where comment~\"^FHR:auto:\"\n/tool netwatch print detail where comment=\"FHR:temporary-tcp\"\n/system scheduler print detail where name~\"^FHR[.]\"\n:put \"A DNS override affects only clients querying this router. These commands change no configuration.\"\n"
    :onerror err in={:local compiled [:parse $source]} do={:error ("Compile check failed: FHR.doctor: " . $err)}
    :set ($FHRInstallSources->"doctor") $source
}

{
    :global FHRInstallSources
    :local source "\n/system script run FHR.purge\n:foreach fhrScheduleName in={\"FHR.auto\";\"FHR.health\";\"FHR.boot\"} do={\n    :foreach fhrScheduleId in=[/system scheduler find where name=\$fhrScheduleName] do={\n        :if (([/system scheduler get \$fhrScheduleId name] = \$fhrScheduleName) && ([/system scheduler get \$fhrScheduleId comment] = \"FHR native v1\")) do={/system scheduler remove \$fhrScheduleId}\n    }\n}\n:foreach id in=[/system script find where comment=\"FHR native v1\"] do={/system script remove \$id}\n:put \"FHR native scripts removed. Uploaded source files were retained.\"\n"
    :onerror err in={:local compiled [:parse $source]} do={:error ("Compile check failed: FHR.uninstall: " . $err)}
    :set ($FHRInstallSources->"uninstall") $source
}

{
    :local parts {"config";"core";"storage";"network";"benchmarks";"discovery";"dns";"engine";"commands";"load";"selftest";"apply";"test";"scan";"status";"health";"restore";"purge";"enable-schedule";"disable-schedule";"help";"doctor";"uninstall"}
    :global FHRInstallSources
    :local sources $FHRInstallSources
    :put "FHR installer 1.0.0: checking sources and exact ownership before changes"
    :foreach part in=$parts do={
        :if ([:typeof ($sources->$part)] != "str") do={:error ("Embedded source missing: " . $part)}
        :local fhrScriptName ("FHR." . $part)
        :local fhrScriptIds [/system script find where name=$fhrScriptName]
        :local fhrExactCount 0
        :foreach fhrScriptId in=$fhrScriptIds do={
            :if ([/system script get $fhrScriptId name] != $fhrScriptName) do={:error ("Script lookup returned a different name: " . $fhrScriptName)}
            :set fhrExactCount ($fhrExactCount + 1)
            :if ([/system script get $fhrScriptId comment] != "FHR native v1") do={:error ("Unmanaged script already uses name " . $fhrScriptName)}
        }
        :if ($fhrExactCount > 1) do={:error ("Duplicate exact script name: " . $fhrScriptName . "; count=" . $fhrExactCount)}
    }
    # Validate all scheduler ownership before disabling any existing schedule.
    :foreach fhrScheduleName in={"FHR.auto";"FHR.health";"FHR.boot"} do={
        :local fhrScheduleIds [/system scheduler find where name=$fhrScheduleName]
        :if ([:len $fhrScheduleIds] > 1) do={:error ("Duplicate exact scheduler name: " . $fhrScheduleName)}
        :foreach fhrScheduleId in=$fhrScheduleIds do={
            :if ([/system scheduler get $fhrScheduleId name] != $fhrScheduleName) do={:error ("Scheduler lookup returned a different name: " . $fhrScheduleName)}
            :if ([/system scheduler get $fhrScheduleId comment] != "FHR native v1") do={:error ("Unmanaged scheduler uses " . $fhrScheduleName)}
        }
    }
    # Avoid two versions writing the same hostnames. Retain the old schedule disabled.
    :foreach fhrLegacyId in=[/system scheduler find where name="FastlyROS-auto-v0.4"] do={
        :if (([/system scheduler get $fhrLegacyId name] = "FastlyROS-auto-v0.4") && ([/system scheduler get $fhrLegacyId comment] = "FastlyROS:auto:v0.4")) do={/system scheduler disable $fhrLegacyId; :put "Disabled legacy v0.4 scheduler"}
    }
    :foreach fhrScheduleName in={"FHR.auto";"FHR.health";"FHR.boot"} do={
        :foreach fhrScheduleId in=[/system scheduler find where name=$fhrScheduleName] do={
            :if (([/system scheduler get $fhrScheduleId name] != $fhrScheduleName) || ([/system scheduler get $fhrScheduleId comment] != "FHR native v1")) do={:error "Scheduler ownership changed during install"}
            /system scheduler disable $fhrScheduleId
            /system scheduler set $fhrScheduleId policy=ftp,read,write,policy,test,sensitive
        }
    }
    :foreach part in=$parts do={
        :local fhrScriptName ("FHR." . $part)
        :local fhrScriptIds [/system script find where name=$fhrScriptName]
        :if ([:len $fhrScriptIds] > 1) do={:error ("Duplicate exact script name during update: " . $fhrScriptName)}
        :if ([:len $fhrScriptIds] = 0) do={
            /system script add name=$fhrScriptName comment="FHR native v1" policy=ftp,read,write,policy,test,sensitive dont-require-permissions=no source=($sources->$part)
        } else={
            :foreach fhrScriptId in=$fhrScriptIds do={
                :if (([/system script get $fhrScriptId name] != $fhrScriptName) || ([/system script get $fhrScriptId comment] != "FHR native v1")) do={:error "Script ownership changed during install"}
                /system script set $fhrScriptId source=($sources->$part) policy=ftp,read,write,policy,test,sensitive dont-require-permissions=no
            }
        }
    }
    :set FHRInstallSources [:toarray ""]
    /system script run FHR.load
    /system script run FHR.selftest use-script-permissions
    :put "INSTALLED 1.0.0. No DNS switch was made by the installer."
    :put "New installation: run /system script run FHR.apply when ready to select DNS targets."
    :put "Existing installation: check FHR.doctor first. To resume automatic operation, run /system script run FHR.enable-schedule."
}
